<%- include('../../partials/header') %>

    <body class="font-display bg-background-light text-[#141414]">
        <div class="relative flex h-auto min-h-[90vh] w-full flex-col group/design-root overflow-x-hidden">
            <div class="layout-container flex h-full grow flex-col">
                <main class="flex-1">
                    <div class="container mx-auto px-4 lg:px-8 py-10 lg:py-20">
                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-12">
                            <div class="lg:col-span-7">
                                <div class="flex flex-col gap-4">
                                    <details
                                        class="flex flex-col rounded-lg border border-[#e0e0e0] bg-white px-4 py-2 group"
                                        open="">
                                        <summary class="flex list-none items-center justify-between gap-6 py-2">
                                            <p class="text-[#141414] text-lg font-medium leading-normal">
                                                Shipping Address
                                            </p>
                                            <div class="text-[#141414]">
                                                <a href="/profile/addresses"
                                                    class="text-[#141414] hover:underline">manage</a>
                                            </div>
                                        </summary>
                                        <div class="pb-4 pt-2">
                                            <fieldset>
                                                <legend class="sr-only">
                                                    Shipping Address Options
                                                </legend>
                                                <div class="space-y-4">
                                                    <% addresses.forEach(addr=> { %>
                                                        <label
                                                            class="flex items-start p-4 rounded-lg border border-[#e0e0e0] has-[:checked]:border-gray-800 has-[:checked]:ring-black/50 cursor-pointer">
                                                            <input
                                                                class="form-radio h-4 w-4 mt-1 text-black focus:ring-black/50 border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:checked:bg-black"
                                                                name="shipping-address" type="radio" checked
                                                                value="<%= addr._id %>" />
                                                            <div class="ml-4 flex-1">
                                                                <p class="font-medium text-[#141414]">
                                                                    <%= addr.name %>
                                                                </p>
                                                                <p class="text-sm text-[#757575]">
                                                                    <%= addr.address1 %>
                                                                </p>
                                                                <span
                                                                    class="inline-block mt-1 px-2 py-0.5 bg-gray-100 text-[#757575] text-xs rounded border border-[#e0e0e0]">
                                                                    <%= addr.type %>
                                                                </span>
                                                            </div>
                                                        </label>
                                                        <% }); %>
                                                            <div onclick="window.location.href='/profile/addresses/add?next=checkout'"
                                                                class="rounded-lg border bg-gray-100 hover:bg-gray-200 transition-colors border-[#e0e0e0]">
                                                                <label class="flex justify-center p-4 cursor-pointer">
                                                                    <div class="ml-4">
                                                                        <p class="font-medium text-[#141414]">
                                                                            Add a new
                                                                            shipping
                                                                            address
                                                                        </p>
                                                                    </div>
                                                                </label>
                                                            </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </details>
                                </div>
                            </div>
                            <div class="lg:col-span-5 mt-10 lg:mt-0">
                                <div class="sticky top-10 rounded-lg bg-white border border-[#e0e0e0] p-6">
                                    <h2 class="text-xl font-semibold mb-6 text-black">
                                        Order Summary
                                    </h2>
                                    <div class="space-y-4">
                                        <% if (locals.product) { %>
                                            <div class="flex items-center gap-4">
                                                <div class="w-20 h-20 rounded-lg bg-gray-200 flex-shrink-0">
                                                    <img class="w-full h-full object-cover rounded-lg"
                                                        data-alt="light wood flooring"
                                                        src="<%= product.productImages[0] %>" />
                                                </div>
                                                <div class="flex-grow">
                                                    <p class="font-medium text-base text-[#141414]">
                                                        <%= product.name %>
                                                    </p>
                                                    <p class="text-sm text-[#757575]">
                                                        Qty: <%= quantity %>
                                                    </p>
                                                </div>
                                                <p class="font-medium text-base text-[#141414]">
                                                    ₹<%= totalAmount.toLocaleString('en-IN') %>
                                                </p>
                                            </div>
                                            <% } else { %>
                                                <% cartItems.forEach(item=> { %>
                                                    <div class="flex items-center gap-4">
                                                        <div class="w-20 h-20 rounded-lg bg-gray-200 flex-shrink-0">
                                                            <img class="w-full h-full object-cover rounded-lg"
                                                                data-alt="light wood flooring"
                                                                src="<%= item.product.productImages[0] %>" />
                                                        </div>
                                                        <div class="flex-grow">
                                                            <p class="font-medium text-base text-[#141414]">
                                                                <%= item.product.name %>
                                                            </p>
                                                            <p class="text-sm text-[#757575]">
                                                                Qty: <%= item.quantity %>
                                                            </p>
                                                        </div>
                                                        <p class="font-medium text-base text-[#141414]">
                                                            ₹<%= item.total.toLocaleString('en-IN') %>
                                                        </p>
                                                    </div>
                                                    <% }); %>
                                                        <% } %>
                                    </div>
                                    <div class="my-6 border-t border-[#e0e0e0]"></div>
                                    <div class="space-y-2">
                                        <div class="flex justify-between text-base text-[#757575]">
                                            <span>Subtotal</span>
                                            <span>₹<%= totalAmount.toLocaleString('en-IN') %></span>
                                        </div>
                                        <div class="flex justify-between text-base text-[#757575]">
                                            <span>Shipping</span>
                                            <span>
                                                <%= shipping==0 ? 'Free' : '₹' + shipping %>
                                            </span>
                                        </div>
                                        <div class="flex justify-between text-base text-[#757575]">
                                            <span>GST (18%)</span>
                                            <span>₹<%= tax.toFixed(2) %></span>
                                        </div>
                                        <div id="discount-row"
                                            class="hidden flex justify-between text-base text-green-600 mb-2">
                                            <span>Coupon Discount</span>
                                            <span id="discount-amount">- ₹0</span>
                                        </div>
                                    </div>


                                    <div class="mt-6">
                                        <label class="text-sm font-medium text-[#141414] mb-2 block">Have a
                                            coupon?</label>
                                        <div class="flex gap-2">
                                            <input type="text" id="coupon-code" placeholder="Enter code"
                                                class="flex-1 min-w-0 rounded-lg border border-[#e0e0e0] px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-black">
                                            <button onclick="applyCoupon()"
                                                class="bg-black text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-opacity-80 transition-colors shrink-0">
                                                Apply
                                            </button>
                                        </div>
                                        <% if (typeof coupens !=='undefined' && coupens.length> 0) { %>
                                            <button type="button" onclick="openCouponModal()"
                                                class="mt-3 text-sm font-medium text-[#141414] flex items-center gap-2">
                                                <i class="ph-bold ph-tag"></i>
                                                View Available Coupons
                                            </button>
                                            <% } %>
                                                <div id="coupon-status"
                                                    class="hidden mt-3 p-3 rounded-lg border border-dashed border-green-500 bg-green-50">
                                                    <div class="flex justify-between items-center">
                                                        <div>
                                                            <p class="text-sm font-bold text-green-700"
                                                                id="applied-code-name"></p>
                                                            <p class="text-xs text-green-600" id="coupon-description">
                                                            </p>
                                                        </div>
                                                        <button onclick="removeCoupon()"
                                                            class="text-red-500 hover:text-red-700">
                                                            <span class="material-symbols-outlined text-sm">close</span>
                                                        </button>
                                                    </div>
                                                </div>
                                    </div>


                                    <div class="my-6 border-t border-[#e0e0e0]"></div>
                                    <div class="flex justify-between text-lg font-bold text-black">
                                        <span>Total</span>
                                        <span class="grand-total-display">₹<%= total.toLocaleString('en-IN') %></span>
                                    </div>
                                </div>
                                <div class="mt-6">
                                    <button onclick="placeOrder()"
                                        class="flex w-full items-center justify-center rounded-lg bg-black text-white font-bold h-12 px-8 text-base leading-normal transition-colors hover:bg-opacity-90">
                                        Place Order
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
        </div>
        <%- include('../../partials/footer') %>

            <!-- Coupon Modal -->
            <div id="coupon-modal" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog"
                aria-modal="true">
                <div class="fixed inset-0 bg-black/50 transition-opacity backdrop-blur-sm" aria-hidden="true"
                    onclick="closeCouponModal()"></div>
                <div class="flex items-center justify-center min-h-screen p-4">
                    <div
                        class="relative bg-white rounded-lg shadow-xl w-full max-w-md overflow-hidden transform transition-all">
                        <div class="px-6 py-4 border-b border-[#e0e0e0] flex justify-between items-center bg-[#f9f9f9]">
                            <h3 class="text-lg font-medium text-[#141414]" id="modal-title">Available Coupons</h3>
                            <button onclick="closeCouponModal()"
                                class="text-[#757575] hover:text-[#141414] transition-colors">
                                <span class="material-symbols-outlined">close</span>
                            </button>
                        </div>

                        <div class="px-6 py-4 max-h-[60vh] overflow-y-auto space-y-3">
                            <% if (typeof coupens !=='undefined' && coupens.length> 0) { %>
                                <% coupens.forEach(coupen=> { %>
                                    <div
                                        class="group border border-[#e0e0e0] rounded-lg p-4 hover:border-black transition-colors bg-white">
                                        <div class="flex justify-between items-start gap-4">
                                            <div class="flex-1">
                                                <div class="flex items-center gap-2 mb-1">
                                                    <span class="font-bold text-[#141414] text-lg tracking-wide">
                                                        <%= coupen.code %>
                                                    </span>
                                                </div>
                                                <p class="text-[#141414] font-medium">
                                                    <%= coupen.discountType==='percentage' ? coupen.discountValue
                                                        + '% OFF' : '₹' + coupen.discountValue + ' OFF' %>
                                                </p>
                                                <% if (coupen.minPurchaseAmount> 0) { %>
                                                    <p class="text-xs text-[#757575] mt-1">Min purchase: ₹<%=
                                                            coupen.minPurchaseAmount %>
                                                    </p>
                                                    <% } %>
                                            </div>
                                            <button onclick="useCoupon('<%= coupen.code %>')"
                                                class="bg-black text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-opacity-80 transition-colors shrink-0">
                                                Add
                                            </button>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <div class="text-center py-8">
                                                <span
                                                    class="material-symbols-outlined text-4xl text-[#e0e0e0] mb-2">sentiment_dissatisfied</span>
                                                <p class="text-[#757575]">No coupons available at the moment.</p>
                                            </div>
                                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <script>
                window.onpageshow = function (event) {
                    if (event.persisted) {
                        // Force a reload from the server to check if session.item is actually null
                        window.location.reload();
                    }
                };
            </script>
            <script>
                function openCouponModal() {
                    document.getElementById('coupon-modal').classList.remove('hidden');
                }

                function closeCouponModal() {
                    document.getElementById('coupon-modal').classList.add('hidden');
                }

                function useCoupon(code) {
                    const input = document.getElementById('coupon-code');
                    input.value = code;
                    closeCouponModal();
                    // Optionally auto-apply
                    // applyCoupon(); 
                }
                let currentDiscount = 0;
                let appliedCouponCode = null;
                const originalTotal = parseFloat('<%= totalAmount %>');
                const fullTotal = parseFloat('<%= total %>');

                async function applyCoupon() {
                    const codeInput = document.getElementById('coupon-code');
                    const code = codeInput.value.trim();

                    if (!code) {
                        return Swal.fire({ icon: 'info', title: 'Please enter a code' });
                    }

                    try {
                        const response = await fetch('/checkout/apply-coupen', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            // Sending total to validate minimum purchase requirements on backend
                            body: JSON.stringify({ code, currentTotal: originalTotal, fullTotal: fullTotal })
                        });

                        const data = await response.json();

                        if (data.success) {
                            currentDiscount = data.discountAmount;
                            appliedCouponCode = code;

                            // UI Updates
                            document.getElementById('coupon-status').classList.remove('hidden');
                            document.getElementById('discount-row').classList.remove('hidden');
                            document.getElementById('applied-code-name').innerText = code;
                            document.getElementById('coupon-description').innerText = `Discount: ₹${currentDiscount}`;
                            document.getElementById('discount-amount').innerText = `- ₹${currentDiscount}`;

                            updateGrandTotal(data.newTotal);

                            Swal.fire({ icon: 'success', title: 'Coupon Applied!', timer: 1500, showConfirmButton: false });
                        } else {
                            Swal.fire({ icon: 'error', title: 'Invalid Coupon', text: data.message });
                        }
                    } catch (error) {
                        console.error('Coupon Error:', error);
                        Swal.fire({ icon: 'error', title: 'Invalid Coupon', text: data.message });
                    }
                }

                function removeCoupon() {
                    currentDiscount = 0;
                    appliedCouponCode = null;
                    document.getElementById('coupon-code').value = '';
                    document.getElementById('coupon-status').classList.add('hidden');
                    document.getElementById('discount-row').classList.add('hidden');

                    updateGrandTotal(fullTotal);
                }

                function updateGrandTotal(newAmount) {
                    const totalDisplay = document.querySelector('.grand-total-display');
                    if (totalDisplay) {
                        totalDisplay.innerText = `₹${newAmount.toLocaleString('en-IN')}`;
                    }
                }
                function placeOrder() {
                    const btn = document.querySelector('button[onclick="placeOrder()"]');
                    const originalContent = btn.innerHTML;

                    const selectedAddress = document.querySelector('input[name="shipping-address"]:checked');
                    // const selectedPaymentMethod = document.querySelector('input[name="payment-method"]:checked');
                    const totalAmount = '<%= totalAmount %>';

                    if (!selectedAddress) {
                        swal.fire({
                            icon: 'warning',
                            title: 'No Address Selected',
                            text: 'Please select a shipping address to proceed.',
                        });
                        return;
                    }

                    // Loading State
                    btn.disabled = true;
                    btn.innerHTML = '<span class="flex items-center gap-2"><i class="ph-bold ph-spinner animate-spin"></i> Placing Order...</span>';
                    btn.classList.add('opacity-70', 'cursor-not-allowed');

                    const orderData = {
                        addressId: selectedAddress.value,
                        coupenCode: appliedCouponCode,
                        totalAmount: parseInt(totalAmount)
                    };

                    fetch('/checkout/place-order', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(orderData)
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                window.location.href = '/payment/' + data.orderId;
                            } else {
                                // Revert State
                                btn.disabled = false;
                                btn.innerHTML = originalContent;
                                btn.classList.remove('opacity-70', 'cursor-not-allowed');

                                swal.fire({
                                    icon: 'error',
                                    title: 'Order Failed',
                                    text: data.message || 'There was an issue placing your order. Please try again.',
                                });
                            }
                        })
                        .catch(error => {
                            // Revert State
                            btn.disabled = false;
                            btn.innerHTML = originalContent;
                            btn.classList.remove('opacity-70', 'cursor-not-allowed');

                            console.error('Error:', error);
                            swal.fire({
                                icon: 'error',
                                title: 'Order Failed',
                                text: 'There was an issue placing your order. Please try again.',
                            });
                        });
                }
            </script>
    </body>

    </html>