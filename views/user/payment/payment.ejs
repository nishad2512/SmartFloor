<%- include('../../partials/header.ejs') %>

    <body class="bg-background-light text-black font-display antialiased min-h-[90vh] flex flex-col">
        <!-- Top Navbar -->
        <main class="flex-grow w-full max-w-[1280px] h-[90vh] mx-auto px-6 lg:px-8 py-12 mt-20">
            <!-- Breadcrumbs -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                <!-- Left Column: Payment Methods -->
                <div class="lg:col-span-7 flex flex-col gap-6">
                    <div>
                        <h1 class="text-3xl lg:text-4xl font-black text-black tracking-tight mb-2">
                            Choose how to pay
                        </h1>
                        <p class="text-[#757575]">
                            Secure transactions encrypted for your safety.
                        </p>
                    </div>
                    <div class="flex flex-col gap-4 mt-4">
                        <!-- Razorpay Option (Inactive) -->
                        <!-- Flatter design to de-emphasize slightly compared to the wallet -->
                        <label
                            class="group relative flex cursor-pointer flex-col gap-4 rounded-xl border p-6 transition-all border-gray-200 bg-gray-50 hover:bg-white hover:shadow-sm has-[:checked]:border-black has-[:checked]:bg-white has-[:checked]:shadow-lg has-[:checked]:ring-1 has-[:checked]:ring-black">
                            <div class="flex items-start justify-between">
                                <div class="flex gap-4 items-center">
                                    <div
                                        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-white text-[#757575] border border-gray-100 shadow-sm">
                                        <i class="ph-bold ph-credit-card text-2xl"></i>
                                    </div>
                                    <div class="flex flex-col">
                                        <p class="text-base font-semibold text-black">
                                            Credit / Debit Card / UPI
                                        </p>
                                        <p class="text-sm text-[#757575] mt-1">
                                            Powered by Razorpay
                                        </p>
                                        <div
                                            class="flex gap-2 mt-2 opacity-60 grayscale group-hover:grayscale-0 group-has-[:checked]:grayscale-0 transition-all">
                                            <!-- Visa Icon Placeholder -->
                                            <div class="h-4 w-8 bg-gray-300 rounded overflow-hidden"
                                                data-alt="Visa logo graphic">
                                                <div
                                                    class="w-full h-full bg-blue-900 flex items-center justify-center text-[6px] text-white font-bold tracking-widest">
                                                    VISA
                                                </div>
                                            </div>
                                            <!-- MC Icon Placeholder -->
                                            <div class="h-4 w-8 bg-gray-300 rounded overflow-hidden"
                                                data-alt="Mastercard logo graphic">
                                                <div class="w-full h-full flex">
                                                    <div class="w-1/2 bg-red-500 h-full rounded-l-sm"></div>
                                                    <div
                                                        class="w-1/2 bg-orange-400 h-full rounded-r-sm -ml-2 rounded-full mix-blend-multiply">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div
                                    class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-gray-300 bg-white dark:bg-transparent ring-offset-2 group-has-[:checked]:border-black group-has-[:checked]:bg-black">
                                    <input checked="" class="h-0 w-0 opacity-0" name="payment_method" type="radio"
                                        value="razorpay" />
                                    <i class="ph-bold ph-check text-white"></i>
                                </div>
                            </div>
                        </label>
                        <!-- Wallet Option (Active/Recommended) -->
                        <!-- This card uses a white background and shadow to pop out against the gray page background, subtly indicating it's the best choice -->
                        <% if (order.totalAmount < user.wallet) { %>
                            <label
                                class="group relative flex cursor-pointer flex-col gap-4 rounded-xl border p-6 transition-all border-gray-200 bg-gray-50 has-[:checked]:border-black has-[:checked]:bg-white has-[:checked]:shadow-lg has-[:checked]:ring-1 has-[:checked]:ring-black">
                                <div class="flex items-start justify-between">
                                    <div class="flex gap-4 items-start">
                                        <div
                                            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-black/5 text-black">
                                            <i class="ph-bold ph-wallet text-2xl"></i>
                                        </div>
                                        <div class="flex flex-col">
                                            <div class="flex items-center gap-3 flex-wrap">
                                                <p class="text-lg font-bold text-black">
                                                    My Wallet
                                                </p>
                                                <!-- Subtle "Smart Choice" Badge -->
                                                <span
                                                    class="inline-flex items-center rounded-full bg-black/10 px-2.5 py-0.5 text-xs font-semibold text-black">
                                                    <i class="ph-bold ph-check"></i>
                                                    Smart Choice
                                                </span>
                                            </div>
                                            <p class="text-sm text-[#757575] mt-1">
                                                Available Balance:
                                                <span class="font-medium text-black">₹<%= user.wallet.toFixed(2) %>
                                                </span>
                                            </p>
                                            <p class="text-xs text-green-600 mt-2 font-medium flex items-center gap-1">
                                                <i class="ph-bold ph-lightning"></i>
                                                Instant refund processing
                                            </p>
                                        </div>
                                    </div>
                                    <div
                                        class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-gray-300 bg-transparent ring-offset-2 group-has-[:checked]:border-black group-has-[:checked]:bg-black">
                                        <input class="h-0 w-0 opacity-0" name="payment_method" type="radio"
                                            value="wallet" />
                                        <i class="ph-bold ph-check text-white"></i>
                                    </div>
                                </div>
                            </label>
                            <% } %>
                                <!-- COD Option (Inactive) -->
                                <label
                                    class="group relative flex cursor-pointer flex-col gap-4 rounded-xl border p-6 transition-all border-gray-200 bg-gray-50 hover:bg-white hover:shadow-sm has-[:checked]:border-black has-[:checked]:bg-white has-[:checked]:shadow-lg has-[:checked]:ring-1 has-[:checked]:ring-black">
                                    <div class="flex items-start justify-between">
                                        <div class="flex gap-4 items-center">
                                            <div
                                                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-white text-[#757575] border border-gray-100 shadow-sm">
                                                <i class="ph-bold ph-truck text-2xl"></i>
                                            </div>
                                            <div class="flex flex-col">
                                                <p class="text-base font-semibold text-black">
                                                    Cash on Delivery
                                                </p>
                                                <p class="text-sm text-[#757575] mt-1">
                                                    Pay upon arrival of your order.
                                                </p>
                                                <p class="text-xs text-orange-600 mt-1 font-medium">
                                                    <!-- Additional $5 handling fee applies -->
                                                </p>
                                            </div>
                                        </div>
                                        <div
                                            class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-gray-300 bg-white dark:bg-transparent ring-offset-2 group-has-[:checked]:border-black group-has-[:checked]:bg-black">
                                            <input class="h-0 w-0 opacity-0" name="payment_method" type="radio"
                                                value="cod" />
                                            <i class="ph-bold ph-check text-white"></i>
                                        </div>
                                    </div>
                                </label>
                    </div>
                    <!-- Security Note -->
                    <div class="mt-6 flex items-center justify-center gap-2 text-xs text-[#757575]">
                        <i class="ph-bold ph-lock"></i>
                        <p>All transactions are secure and encrypted.</p>
                    </div>
                </div>
                <!-- Right Column: Order Summary -->
                <div class="lg:col-span-5">
                    <div
                        class="sticky top-24 rounded-2xl bg-white border border-gray-100 shadow-xl shadow-gray-200/50 overflow-hidden">
                        <div class="p-6 border-b border-gray-100">
                            <h3 class="text-lg font-bold text-black">
                                Order Summary
                            </h3>
                        </div>
                        <!-- Products List -->
                        <div class="p-6 flex flex-col gap-6 max-h-[300px] overflow-y-auto custom-scrollbar">
                            <!-- Product 1 -->
                            <% order.items.forEach(item=> { %>
                                <div class="flex gap-4">
                                    <div
                                        class="h-16 w-16 shrink-0 overflow-hidden rounded-md border border-gray-100 bg-gray-50">
                                        <img alt="Light oak hardwood flooring texture"
                                            class="h-full w-full object-cover"
                                            data-alt="Light oak hardwood flooring sample"
                                            src="<%= item.product.productImages[0] %>" />
                                    </div>
                                    <div class="flex flex-1 flex-col justify-center">
                                        <div class="flex justify-between items-start">
                                            <p class="text-sm font-semibold text-black line-clamp-2">
                                                <%= item.product.name %>
                                            </p>
                                            <p class="text-sm font-bold text-black">
                                                ₹<%= item.subTotal.toFixed(2) %>
                                            </p>
                                        </div>
                                        <p class="text-xs text-[#757575] mt-1">
                                            Qty: <%= item.quantity %>
                                        </p>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                        <!-- Cost Breakdown -->
                        <div class="bg-gray-50 p-6 flex flex-col gap-3">
                            <div class="flex justify-between text-sm text-[#757575]">
                                <span>Subtotal (<%= order.items.length %>)</span>
                                <span>₹<%= order.subTotal.toFixed(2) %></span>
                            </div>
                            <div class="flex justify-between text-sm text-[#757575]">
                                <span>Shipping</span>
                                <span class="text-green-600 font-medium">
                                    <%= order.shipping==0 ? 'Free' : '₹' + order.shipping %>
                                </span>
                            </div>
                            <div class="flex justify-between text-sm text-[#757575]">
                                <span>Tax (Estimated)</span>
                                <span>₹<%= order.tax %></span>
                            </div>
                            <div class="my-2 h-px w-full bg-gray-200"></div>
                            <div class="flex justify-between items-end">
                                <span class="text-base font-semibold text-black">Total</span>
                                <span class="text-2xl font-black text-black tracking-tight">₹<%=
                                        order.totalAmount.toFixed(2) %></span>
                            </div>
                            <button onclick="payNow()" id="payOutButton"
                                data-original-text="Pay ₹<%= order.totalAmount.toFixed(2) %>"
                                class="mt-6 flex w-full items-center justify-center rounded-lg bg-black text-white px-6 py-4 text-base font-bold shadow-lg hover:bg-black transition-colors">
                                Pay ₹<%= order.totalAmount.toFixed(2) %>
                            </button>
                            <p class="text-center text-xs text-[#757575] mt-2">
                                By paying, you agree to our
                                <a class="underline" href="#">Terms</a> &amp;
                                <a class="underline" href="#">Privacy Policy</a>.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        </div>
        <%- include('../../partials/footer.ejs') %>
            <style>
                /* Custom scrollbar for product list */
                .custom-scrollbar::-webkit-scrollbar {
                    width: 4px;
                }

                .custom-scrollbar::-webkit-scrollbar-track {
                    background: transparent;
                }

                .custom-scrollbar::-webkit-scrollbar-thumb {
                    background-color: #e5e5e5;
                    border-radius: 20px;
                }
            </style>
            <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const payButton = document.getElementById('payOutButton');
                    const radioButtons = document.querySelectorAll('input[name="payment_method"]');

                    function updateButtonText() {
                        const selectedMethod = document.querySelector('input[name="payment_method"]:checked');
                        if (selectedMethod && selectedMethod.value === 'cod') {
                            payButton.textContent = 'Continue';
                        } else {
                            payButton.textContent = payButton.dataset.originalText;
                        }
                    }

                    radioButtons.forEach(radio => {
                        radio.addEventListener('change', updateButtonText);
                    });

                    // Initial check in case of pre-selection or back navigation
                    updateButtonText();
                });

                async function payNow() {
                    const amount = Math.round(parseFloat('<%= order.totalAmount %>'));
                    const orderId = '<%= order._id %>';
                    const selectedMethod = document.querySelector('input[name="payment_method"]:checked').value;

                    // Debugging: Check Key ID
                    console.log("Using Key ID:", "<%= razorpayKeyId %>");

                    if (selectedMethod == 'razorpay') {
                        const res = await fetch("/payment/create-order", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ orderId: orderId })
                        });

                        const data = await res.json();

                        const options = {
                            key: "<%= razorpayKeyId %>", // PUBLIC key
                            amount: data.order.amount,
                            currency: "INR",
                            name: "SmartFloor",
                            description: "Order Payment",
                            order_id: data.order.id,

                            prefill: {
                                name: "<%= user.name %>",
                                email: "<%= user.email %>",
                                contact: "9999999999"
                            },
                            retry: {
                                enabled: false
                            },

                            handler: async function (response) {
                                response.orderId = orderId
                                const res = await fetch("/payment/verify-payment", {
                                    method: "POST",
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify(response)
                                });
                                const data = await res.json();
                                if (data.success) {
                                    window.location.href = `/order/confirmation/${orderId}`;
                                }
                            },

                            theme: {
                                color: "#000000",
                            },
                        };

                        console.log("Razorpay Options:", options);

                        const rzp = new Razorpay(options);
                        rzp.on('payment.failed', async function (response) {
                            response.orderId = orderId
                            const res = await fetch("/payment/verify-payment", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify(response)
                            });
                            const data = await res.json();
                            if (!data.success) {
                                window.location.href = `/payment/failed/${orderId}`;
                            }
                        });
                        rzp.open();
                    } else {
                        const res = await fetch("/payment/place-order", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ orderId, selectedMethod })
                        });

                        const data = await res.json();

                        if (data.success) {
                            setTimeout(() => {
                                window.location.href = `/order/confirmation/${orderId}`;
                            });
                        } else {
                            swal.fire({
                                icon: 'error',
                                title: 'Order Failed',
                                text: data.message || 'Payment failed to do.',
                            });
                        }
                    }
                }
            </script>
    </body>

    </html>