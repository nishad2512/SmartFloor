<%- include("../../partials/header.ejs") %>

    <div class="flex flex-col md:flex-row py-12 min-h-[90vh]">
        <!-- Sidebar -->
        <%- include("../../partials/user-sidebar.ejs") %>

            <!-- Main Content -->
            <main class="flex-1 p-6 sm:p-8 md:p-12">
                <div class="max-w-3xl mx-auto">
                    <div class="flex flex-col items-start text-left">
                        <h1 class="text-[#141414] text-3xl sm:text-4xl font-black leading-tight tracking-[-0.033em]">
                            My Wallet
                        </h1>
                        <p class="mt-2 text-[#757575] text-base font-normal leading-normal">
                            Manage your payment methods and view your
                            balance.
                        </p>
                    </div>
                    <div class="mt-10 space-y-8">
                        <div class="bg-white rounded-xl border border-gray-200 p-6 sm:p-8">
                            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                                <div>
                                    <h2 class="text-sm font-medium text-[#757575]">
                                        Wallet Balance
                                    </h2>
                                    <p class="text-3xl font-bold text-[#141414] mt-1">
                                        ₹<%= user.wallet.toLocaleString('en-IN') %>
                                    </p>
                                </div>
                                <button
                                    class="flex min-w-[120px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-6 bg-black text-white text-base font-bold leading-normal w-full sm:w-auto hover:bg-opacity-90"
                                    type="button" onclick="addMoneyToWallet()">
                                    <span class="truncate">Add Funds</span>
                                </button>
                            </div>
                        </div>
                        <div class="bg-white rounded-xl border border-gray-200 p-6 sm:p-8">
                            <div class="flex justify-between items-center">
                                <h2 class="text-xl font-bold text-[#141414]">
                                    Transaction history
                                </h2>
                            </div>
                            <div class="mt-8 space-y-6" id="transaction-list">
                                <% if (transactions && transactions.length> 0) { %>
                                    <% transactions.forEach(transaction=> { %>
                                        <div
                                            class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 rounded-lg bg-background-light border border-gray-100">
                                            <div class="flex items-center gap-4">
                                                <div
                                                    class="w-10 h-10 rounded-full flex items-center justify-center <%= transaction.type === 'credit' ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600' %>">
                                                    <i
                                                        class="ph-bold ph-<%= transaction.type==='credit' ? 'plus' : 'x' %>"></i>
                                                </div>
                                                <div>
                                                    <p class="font-medium text-[#141414]">
                                                        <%= transaction.reason || (transaction.type==='Credit'
                                                            ? 'Wallet Deposit' : 'Wallet Payment' ) %>
                                                    </p>
                                                    <p class="text-sm text-[#757575]">
                                                        <%= new Date(transaction.date).toLocaleDateString('en-IN', {
                                                            year: 'numeric' , month: 'short' , day: 'numeric' ,
                                                            hour: '2-digit' , minute: '2-digit' }) %>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="flex flex-col items-end">
                                                <span
                                                    class="font-bold <%= transaction.type === 'credit' ? 'text-green-600' : 'text-red-600' %>">
                                                    <%= transaction.type==='credit' ? '+' : '-' %>₹<%=
                                                            transaction.amount.toLocaleString('en-IN') %>
                                                </span>
                                                <span class="text-xs text-[#757575] uppercase tracking-wide">
                                                    <%= transaction.type %>
                                                </span>
                                            </div>
                                        </div>
                                        <% }); %>
                                            <% } else { %>
                                                <div class="text-center py-8 text-gray-500">
                                                    <i class="ph-bold ph-wallet"></i>
                                                    <p>No transactions found in your wallet history.</p>
                                                </div>
                                                <% } %>
                            </div>

                            <!-- Pagination Button -->
                            <% if (typeof hasMore !=='undefined' && hasMore) { %>
                                <div id="pagination-container" class="mt-8 text-center">
                                    <button id="load-more-btn"
                                        class="px-6 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-full font-medium transition-colors text-sm"
                                        data-page="1">
                                        See More Transactions
                                    </button>
                                </div>
                                <% } %>
                                
                                    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
                                    <script>
                                        document.addEventListener('DOMContentLoaded', () => {
                                            const loadMoreBtn = document.getElementById('load-more-btn');
                                            const container = document.getElementById('transaction-list');
                                            const paginationContainer = document.getElementById('pagination-container');

                                            if (loadMoreBtn) {
                                                loadMoreBtn.addEventListener('click', async () => {
                                                    const originalText = loadMoreBtn.innerText;
                                                    loadMoreBtn.innerText = "Loading...";
                                                    loadMoreBtn.disabled = true;

                                                    const nextPage = parseInt(loadMoreBtn.dataset.page) + 1;

                                                    try {
                                                        const response = await fetch(`/profile/wallet?page=${nextPage}&limit=5&ajax=true`);
                                                        const data = await response.json();

                                                        if (data.success && data.transactions.length > 0) {
                                                            data.transactions.forEach(transaction => {
                                                                const isCredit = transaction.type === 'credit';
                                                                const date = new Date(transaction.date).toLocaleDateString('en-IN', {
                                                                    year: 'numeric', month: 'short', day: 'numeric',
                                                                    hour: '2-digit', minute: '2-digit'
                                                                });
                                                                const amount = transaction.amount.toLocaleString('en-IN');
                                                                const reason = transaction.reason || (isCredit ? 'Wallet Deposit' : 'Wallet Payment');

                                                                const html = `
                                                            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 rounded-lg bg-background-light border border-gray-100 animate-fade-in">
                                                                <div class="flex items-center gap-4">
                                                                    <div class="w-10 h-10 rounded-full flex items-center justify-center ${isCredit ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600'}">
                                                                        <i class="ph-bold ph-${isCredit ? 'plus' : 'x'}"></i>
                                                                    </div>
                                                                    <div>
                                                                        <p class="font-medium text-[#141414]">${reason}</p>
                                                                        <p class="text-sm text-[#757575]">${date}</p>
                                                                    </div>
                                                                </div>
                                                                <div class="flex flex-col items-end">
                                                                    <span class="font-bold ${isCredit ? 'text-green-600' : 'text-red-600'}">
                                                                        ${isCredit ? '+' : '-'}₹${amount}
                                                                    </span>
                                                                    <span class="text-xs text-[#757575] uppercase tracking-wide">
                                                                        ${transaction.type}
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        `;
                                                                container.insertAdjacentHTML('beforeend', html);
                                                            });

                                                            loadMoreBtn.dataset.page = nextPage;

                                                            if (!data.hasMore) {
                                                                paginationContainer.style.display = 'none';
                                                            }
                                                        } else {
                                                            paginationContainer.style.display = 'none';
                                                        }
                                                    } catch (err) {
                                                        console.error('Error loading transactions:', err);
                                                    } finally {
                                                        loadMoreBtn.innerText = originalText;
                                                        loadMoreBtn.disabled = false;
                                                    }
                                                });
                                            }
                                        });

                                        function addMoneyToWallet() {
                                            Swal.fire({
                                                title: 'Add Money to Wallet',
                                                html: `
                                                    <div style="text-align:left; font-family: 'Inter', -apple-system, sans-serif; padding: 10px 5px;">
                                                        <label style="font-weight:500; color:#374151; margin-bottom:8px; display:block; font-size:14px;">
                                                            Enter Amount
                                                        </label>

                                                        <div style="
                                                            display:flex;
                                                            align-items:center;
                                                            border:2px solid #f3f4f6;
                                                            border-radius:12px;
                                                            padding:12px 16px;
                                                            margin-bottom:20px;
                                                            background: #f9fafb;
                                                            transition: border-color 0.2s;
                                                            " id="amountWrapper">
                                                            <span style="font-size:20px; font-weight:600; color:#111827; margin-right:10px">₹</span>
                                                            <input 
                                                                id="walletAmount"
                                                                type="number"
                                                                placeholder="0.00"
                                                                min="1"
                                                                style="
                                                                border:none;
                                                                background:transparent;
                                                                outline:none;
                                                                width:100%;
                                                                font-size:20px;
                                                                font-weight:600;
                                                                color:#111827;
                                                                "
                                                            />
                                                        </div>

                                                        <div style="display:flex; gap:10px; margin-bottom:20px">
                                                            <button class="quick-amount" data-amount="100">₹100</button>
                                                            <button class="quick-amount" data-amount="500">₹500</button>
                                                            <button class="quick-amount" data-amount="1000">₹1000</button>
                                                        </div>

                                                        <div style="display:flex; align-items:center; gap:8px; color:#6b7280; background:#f3f4f6; padding:10px; border-radius:8px;">
                                                            <span style="font-size:16px;">⚡</span>
                                                            <p style="font-size:12px; margin:0;">Funds will be available in your balance immediately.</p>
                                                        </div>
                                                    </div>
                                                `,
                                                showCancelButton: true,
                                                confirmButtonText: 'Proceed to Pay',
                                                cancelButtonText: 'Maybe Later',
                                                confirmButtonColor: 'black',
                                                customClass: {
                                                    popup: 'wallet-popup-custom',
                                                    confirmButton: 'wallet-confirm-btn',
                                                    cancelButton: 'wallet-cancel-btn',
                                                    title: 'wallet-title-custom'
                                                },
                                                didOpen: () => {
                                                    const input = document.getElementById('walletAmount');
                                                    const wrapper = document.getElementById('amountWrapper');
                                                    
                                                    // Focus effect
                                                    input.addEventListener('focus', () => wrapper.style.borderColor = '#3b82f6');
                                                    input.addEventListener('blur', () => wrapper.style.borderColor = '#f3f4f6');

                                                    document.querySelectorAll('.quick-amount').forEach(btn => {
                                                        btn.style.cssText = `
                                                            flex:1;
                                                            padding:10px 5px;
                                                            border-radius:10px;
                                                            border:1px solid #e5e7eb;
                                                            background:#fff;
                                                            cursor:pointer;
                                                            font-weight:500;
                                                            color:#4b5563;
                                                            transition: all 0.2s;
                                                            font-size: 14px;
                                                        `;

                                                        btn.addEventListener('mouseenter', () => {
                                                            btn.style.background = '#f9fafb';
                                                            btn.style.borderColor = '#d1d5db';
                                                        });

                                                        btn.addEventListener('mouseleave', () => {
                                                            btn.style.background = '#fff';
                                                            btn.style.borderColor = '#e5e7eb';
                                                        });

                                                        btn.addEventListener('click', () => {
                                                            input.value = btn.dataset.amount;
                                                            // Flash effect on input
                                                            wrapper.style.backgroundColor = '#eff6ff';
                                                            setTimeout(() => wrapper.style.backgroundColor = '#f9fafb', 200);
                                                        });
                                                    });
                                                },
                                                preConfirm: () => {
                                                    const amount = document.getElementById('walletAmount').value;
                                                    if (!amount || amount <= 0) {
                                                        Swal.showValidationMessage('Please enter a valid amount');
                                                    }
                                                    return amount;
                                                }
                                            }).then((result) => {
                                                if (result.isConfirmed) {
                                                    processWalletTopUp(result.value);
                                                }
                                            });
                                        }

                                        async function processWalletTopUp(amount) {
                                            try {
                                                const res = await fetch("/payment/create-order", {
                                                    method: "POST",
                                                    headers: { "Content-Type": "application/json" },
                                                    body: JSON.stringify({ amount })
                                                });

                                                const data = await res.json();

                                                const options = {
                                                    key: "rzp_test_RysFjKh7FeeVsH", // PUBLIC key
                                                    amount: data.order.amount,
                                                    currency: "INR",
                                                    name: "SmartFloor",
                                                    description: "Wallet TopUp",
                                                    order_id: data.order.id,

                                                    prefill: {
                                                        name: "<%= user.name %>",
                                                        email: "<%= user.email %>",
                                                        contact: "9999999999"
                                                    },
                                                    retry: {
                                                        enabled: false
                                                    },

                                                    handler: async function (response) {
                                                        response.amount = amount;
                                                        const res = await fetch("/payment/verify-payment", {
                                                            method: "POST",
                                                            headers: { "Content-Type": "application/json" },
                                                            body: JSON.stringify(response)
                                                        });
                                                        const data = await res.json();
                                                        if (data.success) {
                                                            location.reload();
                                                        }
                                                    },

                                                    theme: {
                                                        color: "#000000",
                                                    },
                                                };

                                                console.log("Razorpay Options:", options);

                                                const rzp = new Razorpay(options);
                                                rzp.open();
                                            } catch (error) {
                                                Swal.fire({
                                                icon: 'error',
                                                title: 'Failed',
                                                text: error.message || 'Something went wrong'
                                                });
                                            }
                                        }

                                    </script>
                        </div>
                    </div>
            </main>
            </div>
            </div>
            <%- include('../../partials/footer.ejs') %>
    </div>
    </div>
    </body>

    </html>