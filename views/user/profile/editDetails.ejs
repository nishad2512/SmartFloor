<%- include("../../partials/header.ejs") %>

    <div class="flex flex-col md:flex-row gap-8 md:gap-[200px] py-12 min-h-[90vh] pb-24 md:pb-12">
        <!-- Sidebar -->
        <%- include("../../partials/user-sidebar.ejs") %>

            <!-- Main Content -->
            <main class="flex-1 max-w-4xl">
                <div class="mb-10">
                    <h2 class="text-4xl font-extrabold text-[#1A1A1A] mb-3">
                        Edit Details
                    </h2>
                    <p class="text-gray-500 text-base">
                        Update your personal information.
                    </p>
                </div>

                <div class="space-y-12">
                    <!-- Edit Form -->
                    <section>
                        <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-6">
                            <h3 class="text-xl font-bold text-[#1A1A1A]">
                                Personal Information
                            </h3>
                        </div>
                        <div
                            class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-lg transition-shadow duration-300">
                            <form id="editDetailsForm" onsubmit="return handleDetailsSubmit(event)" class="space-y-6">
                                <div>
                                    <label class="block text-sm font-medium text-[#1A1A1A] mb-4">Profile Picture</label>
                                    <div class="flex items-center gap-5">
                                        <label for="image" class="cursor-pointer">
                                            <div
                                                class="size-20 rounded-full bg-gray-50 flex items-center justify-center overflow-hidden border-2 border-gray-200 hover:border-[#1A1A1A] transition-colors">
                                                <img id="profilePreview"
                                                    src="<%= user.avatar ? user.avatar : 'https://picsum.photos/100/100' %>"
                                                    class="w-full h-full object-cover" alt="profile photo" />
                                            </div>
                                        </label>
                                        <input type="file" name="image" id="image" accept="image/*" class="hidden"
                                            onchange="previewImage(event)" />
                                        <div>
                                            <p class="text-[#1A1A1A] font-bold text-base">
                                                Change Profile Picture
                                            </p>
                                            <p class="text-gray-500 text-sm">
                                                Click the image to upload a new one
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <label for="name" class="block text-sm font-medium text-[#1A1A1A] mb-2">Full
                                        Name</label>
                                    <input type="text" name="name" id="name" value="<%= user.name %>"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1A1A1A] focus:border-transparent"
                                        placeholder="Enter your full name" required />
                                    <div id="nameError" class="error-message"></div>
                                </div>
                                <div>
                                    <label for="phone" class="block text-sm font-medium text-[#1A1A1A] mb-2">
                                        Phone Number
                                    </label>

                                    <div class="flex gap-3">
                                        <input type="text" id="phone" name="phone" value="<%= user.phone %>"
                                            class="flex-1 px-4 py-3 border border-gray-300 rounded-lg"
                                            placeholder="+91XXXXXXXXXX" />

                                        <button type="button" id="sendOtpBtn"
                                            class="px-4 py-3 bg-black text-white rounded-lg">
                                            Verify
                                        </button>
                                    </div>
                                    <div id="phoneError" class="error-message"></div>

                                    <p id="otpMsg" class="text-sm mt-2 text-green-600 hidden">
                                        OTP sent successfully
                                    </p>
                                </div>

                                <!-- OTP Box -->
                                <div id="otpBox" class="hidden mt-4">
                                    <input type="text" id="otp" placeholder="Enter OTP" name="otp"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg" />

                                    <button type="button" onclick="verifyOtp()"
                                        class="mt-3 px-4 py-3 bg-green-600 text-white rounded-lg">
                                        Confirm OTP
                                    </button>
                                </div>

                                <div class="flex gap-4">
                                    <button type="submit"
                                        class="px-6 py-3 bg-[#1A1A1A] text-white font-semibold rounded-lg hover:bg-gray-800 transition-colors">
                                        Save Changes
                                    </button>
                                    <a href="/profile/details"
                                        class="px-6 py-3 border border-gray-300 text-[#1A1A1A] font-semibold rounded-lg hover:bg-gray-100 transition-colors">Cancel</a>
                                </div>
                            </form>
                        </div>
                    </section>
                </div>
            </main>
    </div>

    <style>
        .error-message {
            color: #dc2626;
            font-size: 0.875rem;
            margin-top: 0.35rem;
            display: none;
        }

        .error-message.show {
            display: block;
        }

        .input-error {
            border-color: #dc2626 !important;
        }
    </style>

    <script>
        // Validation helpers
        function showError(inputEl, errorEl, msg) {
            if (errorEl) {
                errorEl.textContent = msg;
                errorEl.classList.add("show");
            }
            if (inputEl) inputEl.classList.add("input-error");
        }

        function clearError(inputEl, errorEl) {
            if (errorEl) {
                errorEl.textContent = "";
                errorEl.classList.remove("show");
            }
            if (inputEl) inputEl.classList.remove("input-error");
        }

        function validateName() {
            const nameInput = document.getElementById("name");
            const nameError = document.getElementById("nameError");
            const name = nameInput.value.trim();

            if (!name || name.length < 3 || !/^[a-zA-Z\s]+$/.test(name)) {
                showError(nameInput, nameError, "Name must be at least 3 characters and contain only letters");
                return false;
            }
            clearError(nameInput, nameError);
            return true;
        }

        function validatePhone(isVerify = false) {
            const phoneInput = document.getElementById("phone");
            const phoneError = document.getElementById("phoneError");
            const phone = phoneInput.value.trim();

            if (isVerify && !phone) {
                showError(phoneInput, phoneError, "Phone number is required");
                return false;
            }

            if (phone && !/^\d{10}$/.test(phone)) {
                showError(phoneInput, phoneError, "Phone number must be exactly 10 digits");
                return false;
            }
            clearError(phoneInput, phoneError);
            return true;
        }

        async function handleDetailsSubmit(event) {
            event.preventDefault();

            if (!validateName()) return false;
            // Note: Phone validation is optional here as it is verified separately, 
            // but we can enforce valid format if something is entered
            if (!validatePhone()) return false;

            const form = event.target;
            const formData = new FormData(form);
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerText;

            try {
                submitBtn.innerText = 'Saving...';
                submitBtn.disabled = true;

                const response = await fetch('/profile/details/edit', {
                    method: 'PATCH',
                    headers: {
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                const result = await response.json();

                if (response.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: result.message || 'Details updated successfully',
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => {
                        window.location.href = '/profile/details';
                    });
                } else {
                    throw new Error(result.message || 'Failed to update details');
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: error.message
                });
                submitBtn.innerText = originalText;
                submitBtn.disabled = false;
            }
            return false;
        }

        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                if (!file.type.startsWith('image/')) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid File',
                        text: 'Please select an image file'
                    });
                    event.target.value = ''; // Reset input
                    return;
                }
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById("profilePreview").src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }
        const sendOtpBtn = document.getElementById("sendOtpBtn");
        const otpBox = document.getElementById("otpBox");
        const otpMsg = document.getElementById("otpMsg");

        // Add blur listeners
        document.getElementById("name").addEventListener("blur", validateName);
        document.getElementById("phone").addEventListener("blur", () => validatePhone(false));

        sendOtpBtn.addEventListener("click", async () => {
            if (!validatePhone(true)) return;

            const phone = document.getElementById("phone").value;

            // if (!phone) return alert("Enter phone number"); // Handled by validatePhone

            const res = await fetch("/profile/send-otp", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ phone }),
            });

            const data = await res.json();

            if (data.success) {
                otpMsg.classList.remove("hidden");
                otpBox.classList.remove("hidden");
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message
                });
            }
        });

        async function verifyOtp() {
            const phone = document.getElementById("phone").value;
            const otp = document.getElementById("otp").value;

            if (!otp) {
                Swal.fire({ icon: 'warning', text: 'Please enter OTP' });
                return;
            }

            const res = await fetch("/profile/verify-otp", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ phone, otp }),
            });

            const data = await res.json();

            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Verified',
                    text: 'Phone number verified!',
                    showConfirmButton: false,
                    timer: 1500
                });
                otpBox.classList.add("hidden");
                otpMsg.classList.add("hidden");
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message || "Invalid OTP"
                });
            }
        }
    </script>

    <div class="hidden md:block">
        <%- include("../../partials/footer.ejs") %>
    </div>