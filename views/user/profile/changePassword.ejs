<%- include("../../partials/header.ejs") %>
    <style>
        .error-message {
            color: #dc2626;
            font-size: 0.875rem;
            margin-top: 0.35rem;
            display: none;
        }

        .error-message.show {
            display: block;
        }

        .input-error {
            border-color: #dc2626 !important;
        }
    </style>

    <div class="flex flex-col md:flex-row gap-8 md:gap-[200px] py-12 min-h-[90vh] pb-24 md:pb-12">
        <!-- Sidebar -->
        <%- include("../../partials/user-sidebar.ejs") %>

            <!-- Main Content -->
            <main class="flex-1 max-w-4xl">
                <div class="mb-10">
                    <h2 class="text-4xl font-extrabold text-[#1A1A1A] mb-3">
                        Change Password
                    </h2>
                    <p class="text-gray-500 text-base">
                        Ensure your account is secure by using a strong password.
                    </p>
                </div>

                <div class="space-y-12">
                    <!-- Edit Form -->
                    <section>
                        <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-6">
                            <h3 class="text-xl font-bold text-[#1A1A1A]">
                                Password Information
                            </h3>
                        </div>
                        <div
                            class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-lg transition-shadow duration-300">
                            <form id="changePasswordForm" onsubmit="return handleChangePassword(event)"
                                class="space-y-6">

                                <div>
                                    <label for="currentPassword"
                                        class="block text-sm font-medium text-[#1A1A1A] mb-2">Current Password</label>
                                    <div class="relative">
                                        <input type="password" name="currentPassword" id="currentPassword"
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1A1A1A] focus:border-transparent pr-10"
                                            placeholder="Enter current password" required />
                                        <div class="absolute inset-y-0 right-0 flex items-center justify-center pr-3 cursor-pointer text-gray-500"
                                            id="toggleCurrent">
                                            <i class="ph-bold ph-eye-slash text-xl" id="iconCurrent"></i>
                                        </div>
                                    </div>
                                    <div id="currentError" class="error-message"></div>
                                </div>

                                <div>
                                    <label for="newPassword" class="block text-sm font-medium text-[#1A1A1A] mb-2">New
                                        Password</label>
                                    <div class="relative">
                                        <input type="password" name="newPassword" id="newPassword"
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1A1A1A] focus:border-transparent pr-10"
                                            placeholder="Enter new password" required />
                                        <div class="absolute inset-y-0 right-0 flex items-center justify-center pr-3 cursor-pointer text-gray-500"
                                            id="toggleNew">
                                            <i class="ph-bold ph-eye-slash text-xl" id="iconNew"></i>
                                        </div>
                                    </div>
                                    <div id="newError" class="error-message"></div>
                                </div>

                                <div>
                                    <label for="confirmPassword"
                                        class="block text-sm font-medium text-[#1A1A1A] mb-2">Confirm Password</label>
                                    <div class="relative">
                                        <input type="password" name="confirmPassword" id="confirmPassword"
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1A1A1A] focus:border-transparent pr-10"
                                            placeholder="Confirm new password" required />
                                        <div class="absolute inset-y-0 right-0 flex items-center justify-center pr-3 cursor-pointer text-gray-500"
                                            id="toggleConfirm">
                                            <i class="ph-bold ph-eye-slash text-xl" id="iconConfirm"></i>
                                        </div>
                                    </div>
                                    <div id="confirmError" class="error-message"></div>
                                </div>

                                <div class="flex gap-4">
                                    <button type="submit"
                                        class="px-6 py-3 bg-[#1A1A1A] text-white font-semibold rounded-lg hover:bg-gray-800 transition-colors">
                                        Update Password
                                    </button>
                                    <a href="/profile/details"
                                        class="px-6 py-3 border border-gray-300 text-[#1A1A1A] font-semibold rounded-lg hover:bg-gray-100 transition-colors">Cancel</a>
                                </div>
                            </form>
                        </div>
                    </section>
                </div>
            </main>
    </div>

    <script>
        // Setup toggles
        function setupToggle(toggleId, inputId, iconId) {
            const toggle = document.getElementById(toggleId);
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (toggle && input && icon) {
                toggle.addEventListener('click', () => {
                    const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                    input.setAttribute('type', type);

                    if (type === 'password') {
                        icon.classList.remove('ph-eye');
                        icon.classList.add('ph-eye-slash');
                    } else {
                        icon.classList.remove('ph-eye-slash');
                        icon.classList.add('ph-eye');
                    }
                });
            }
        }

        setupToggle('toggleCurrent', 'currentPassword', 'iconCurrent');
        setupToggle('toggleNew', 'newPassword', 'iconNew');
        setupToggle('toggleConfirm', 'confirmPassword', 'iconConfirm');

        // Validation logic
        const currentInput = document.getElementById("currentPassword");
        const newInput = document.getElementById("newPassword");
        const confirmInput = document.getElementById("confirmPassword");

        const currentError = document.getElementById("currentError");
        const newError = document.getElementById("newError");
        const confirmError = document.getElementById("confirmError");

        function showError(inputEl, errorEl, msg) {
            if (errorEl) {
                errorEl.textContent = msg;
                errorEl.classList.add("show");
            }
            if (inputEl) inputEl.classList.add("input-error");
        }

        function clearErrors() {
            [currentError, newError, confirmError].forEach(el => {
                if (el) { el.textContent = ""; el.classList.remove("show"); }
            });
            [currentInput, newInput, confirmInput].forEach(el => {
                if (el) el.classList.remove("input-error");
            });
        }

        function validate() {
            clearErrors();
            let ok = true;

            const current = currentInput.value;
            const newVal = newInput.value;
            const confirmVal = confirmInput.value;

            if (!current) {
                showError(currentInput, currentError, "Current password is required");
                ok = false;
            }

            if (!newVal || newVal.length < 8 || !/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)/.test(newVal)) {
                showError(newInput, newError, "Password must be at least 8 characters and include UPPERCASE, lowercase, and a number");
                ok = false;
            }

            if (newVal !== confirmVal) {
                showError(confirmInput, confirmError, "Passwords do not match");
                ok = false;
            }

            return ok;
        }

        // Real-time validation
        if (newInput) newInput.addEventListener("blur", () => {
            if (newInput.value.length > 0 && (newInput.value.length < 8 || !/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)/.test(newInput.value))) {
                showError(newInput, newError, "Password must be at least 8 characters and include UPPERCASE, lowercase, and a number");
            } else {
                newError.classList.remove("show");
                newInput.classList.remove("input-error");
            }
        });

        if (confirmInput) confirmInput.addEventListener("blur", () => {
            if (confirmInput.value && confirmInput.value !== newInput.value) {
                showError(confirmInput, confirmError, "Passwords do not match");
            } else {
                confirmError.classList.remove("show");
                confirmInput.classList.remove("input-error");
            }
        });

        async function handleChangePassword(event) {
            event.preventDefault();

            if (!validate()) return false;

            const form = event.target;
            const currentPassword = form.currentPassword.value;
            const newPassword = form.newPassword.value;
            const confirmPassword = form.confirmPassword.value;
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerText;

            try {
                submitBtn.innerText = 'Updating...';
                submitBtn.disabled = true;

                const response = await fetch('/profile/change-password', {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
                });

                const result = await response.json();

                if (response.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: result.message || 'Password updated successfully',
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => {
                        window.location.href = '/profile/details';
                    });
                } else {
                    throw new Error(result.message || 'Failed to update password');
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: error.message
                });
                submitBtn.innerText = originalText;
                submitBtn.disabled = false;
            }
            return false;
        }
    </script>

    <div class="hidden md:block">
        <%- include("../../partials/footer.ejs") %>
    </div>