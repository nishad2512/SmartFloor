<%- include('../../partials/header') %>

    <body class="font-display">
        <div
            class="relative flex h-auto min-h-[90vh] w-full flex-col bg-background-light group/design-root overflow-x-hidden">
            <div class="layout-container flex h-full grow flex-col">
                <div class="px-4 sm:px-10 md:px-20 lg:px-40 flex flex-1 justify-center py-5">
                    <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
                        <!-- PageHeading and Share Button -->
                        <div class="flex flex-wrap justify-between gap-3 p-4 items-center">
                            <p class="text-[#141414] text-4xl font-black leading-tight tracking-[-0.033em] min-w-72">
                                My Wishlist
                            </p>
                        </div>
                        <!-- Breadcrumbs -->
                        <div class="flex flex-wrap gap-2 px-4 pb-4">
                            <a class="text-[#757575] text-base font-medium leading-normal" href="/">Home</a>
                            <span class="text-[#757575] text-base font-medium leading-normal">/</span>
                            <span class="text-[#141414] text-base font-medium leading-normal">My Wishlist</span>
                        </div>
                        <!-- Wishlist with items -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                            <!-- Product Card 1 -->
                            <% wishlistItems.forEach((item, index)=> { %>
                                <div
                                    class="bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition overflow-hidden">

                                    <!-- Image section -->
                                    <div class="w-full aspect-square overflow-hidden">
                                        <img src="<%= item.product.productImages[0] %>" alt="<%= item.product.name %>"
                                            class="w-full h-full object-cover transition-transform duration-300 hover:scale-105" />
                                    </div>

                                    <!-- Content section -->
                                    <div class="p-4 flex flex-col gap-2">
                                        <p class="text-lg font-bold text-[#141414] line-clamp-2">
                                            <%= item.product.name %>
                                        </p>

                                        <p class="text-sm text-gray-600">
                                            Size: <%= variants[index].size %>
                                        </p>

                                        <div class="flex items-center gap-2 mt-1">
                                            <% if (variants[index].offerPrice) { %>
                                                <span class="text-lg font-bold text-green-600">
                                                    ₹<%= variants[index].offerPrice %>
                                                </span>
                                                <span class="text-sm line-through text-gray-400">
                                                    ₹<%= variants[index].price %>
                                                </span>
                                                <% } else { %>
                                                    <span class="text-lg font-bold">
                                                        ₹<%= variants[index].price %>
                                                    </span>
                                                    <% } %>
                                        </div>

                                        <!-- Actions -->
                                        <div class="mt-3 flex flex-col gap-2">
                                            <% if (item.product.active) { %>
                                            <button
                                                onclick="addToCartFromWishlist('<%= item.product._id %>', '<%= variants[index]._id %>', '<%= item._id %>')"
                                                class="w-full h-10 rounded-lg bg-black text-white font-semibold hover:bg-gray-900">
                                                Add to Cart
                                            </button>
                                            <% } else { %>
                                            <button type="button" disabled
                                                class="w-full h-10 rounded-lg bg-gray-400 text-white font-semibold cursor-not-allowed">
                                                Product Unavailable
                                            </button>
                                            <% } %>
                                            <button type="button" onclick="removeFromWishlist('<%= item._id %>')"
                                                class="h-10 rounded-lg border font-semibold hover:bg-gray-100">
                                                Remove
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Product Card 2 -->
                                <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>
        <%- include('../../partials/footer') %>
            <script>

                function addToCartFromWishlist(productId, variantId, itemId) {
                    // 1. Add to Cart
                    fetch('/cart/add', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            productId: productId,
                            variantId: variantId,
                            quantity: 1
                        })
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                // 2. Remove from Wishlist
                                fetch('/wishlist/remove', {
                                    method: 'DELETE',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify({ itemId: itemId })
                                })
                                    .then(res => res.json())
                                    .then(removeData => {
                                        if (removeData.success) {
                                            // 3. Reload Page
                                            Swal.fire({
                                                icon: 'success',
                                                title: 'Added to Cart',
                                                text: 'Product moved to cart successfully',
                                                showConfirmButton: false,
                                                timer: 1500
                                            }).then(() => {
                                                location.reload();
                                            });
                                        } else {
                                            console.error("Failed to remove from wishlist:", removeData.message);
                                            location.reload(); // Still reload if added to cart but failed to remove
                                        }
                                    });
                            } else {
                                Swal.fire({
                                    icon: 'info',
                                    title: 'Info',
                                    text: data.message
                                });
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'An error occurred.'
                            });
                        });
                }

                function removeFromWishlist(itemId) {
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "You won't be able to revert this!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#000000',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, remove it!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            fetch('/wishlist/remove', {
                                method: 'DELETE',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ itemId: itemId })
                            })
                                .then(response => response.json())
                                .then(data => {
                                    if (data.success) {
                                        Swal.fire(
                                            'Removed!',
                                            data.message,
                                            'success'
                                        ).then(() => {
                                            location.reload();
                                        });
                                    } else {
                                        Swal.fire(
                                            'Error!',
                                            data.message,
                                            'error'
                                        );
                                    }
                                })
                                .catch(error => {
                                    console.error('Error:', error);
                                    Swal.fire(
                                        'Error!',
                                        'An error occurred while removing the item.',
                                        'error'
                                    );
                                });
                        }
                    })
                }
            </script>
    </body>

    </html>