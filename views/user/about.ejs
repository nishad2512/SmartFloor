                <p class="text-gray-400 text-base mb-12 w-3/4 leading-relaxed">
                    We provide the reasons SmartFloor stands out as the
                    ultimate choice for flooring solutions.
                </p>

                <div class="flex flex-col space-y-2" id="accordion-container">
                    <!-- Item 1 -->
                    <div class="border-b border-gray-100 py-6 accordion-item">
                        <div class="flex justify-between items-center cursor-pointer group accordion-header">
