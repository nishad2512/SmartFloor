<%- include('../../partials/admin-header.ejs') %>

    <body class="bg-background-light dark:bg-background-dark font-display text-[#141414] dark:text-white">
        <%- include('../../partials/flash.ejs') %>
            <div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden">
                <div class="flex min-h-screen">
                    <%- include('../../partials/sidebar.ejs') %>
                        <main class="flex-1 p-6 lg:p-10">
                            <div class="layout-content-container flex flex-col w-full max-w-7xl mx-auto">
                                <div class="flex flex-col gap-1 mb-6 sm:flex-row sm:items-center sm:justify-between">
                                    <div>
                                        <p
                                            class="text-[#141414] dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]">
                                            Offer Management
                                        </p>
                                        <p
                                            class="text-[#757575] dark:text-gray-400 text-base font-normal leading-normal">
                                            Create, view, edit, and delete promotional
                                            offers.
                                        </p>
                                    </div>
                                    <button onclick="window.location.href='/admin/offers/create'"
                                        class="flex items-center justify-center gap-2 rounded-lg bg-primary text-white px-5 py-2.5 font-medium hover:opacity-90 w-full mt-4 sm:w-auto sm:mt-0 h-[46px]">
                                        <span class="material-symbols-outlined">add</span>
                                        <span>Create New Offer</span>
                                    </button>
                                </div>
                                <div class="flex flex-col gap-4 mb-6">
                                    <form action="/admin/offers" method="GET"
                                        class="flex flex-col sm:flex-row gap-4 w-full">
                                        <div class="relative flex-1">
                                            <span
                                                class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-gray-500 text-lg">search</span>
                                            <input type="text" name="search"
                                                value="<%= typeof search !== 'undefined' ? search : '' %>"
                                                placeholder="Search by offer name..."
                                                class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] text-sm focus:outline-none focus:border-primary transition-colors">
                                        </div>

                                        <div class="flex flex-wrap gap-4">
                                            <select name="isActive" onchange="this.form.submit()"
                                                class="px-4 py-2.5 rounded-lg border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] text-sm focus:outline-none focus:border-primary cursor-pointer">
                                                <option value="">All Status</option>
                                                <option value="active" <%=typeof isActive !=='undefined' &&
                                                    isActive==='active' ? 'selected' : '' %>>Active</option>
                                                <option value="inactive" <%=typeof isActive !=='undefined' &&
                                                    isActive==='inactive' ? 'selected' : '' %>>Inactive</option>
                                            </select>

                                            <select name="scope" onchange="this.form.submit()"
                                                class="px-4 py-2.5 rounded-lg border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] text-sm focus:outline-none focus:border-primary cursor-pointer">
                                                <option value="">All Scopes</option>
                                                <option value="product" <%=typeof scope !=='undefined' &&
                                                    scope==='product' ? 'selected' : '' %>>Product</option>
                                                <option value="category" <%=typeof scope !=='undefined' &&
                                                    scope==='category' ? 'selected' : '' %>>Category</option>
                                            </select>

                                            <select name="sort" onchange="this.form.submit()"
                                                class="px-4 py-2.5 rounded-lg border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] text-sm focus:outline-none focus:border-primary cursor-pointer">
                                                <option value="newest" <%=typeof sort !=='undefined' && sort==='newest'
                                                    ? 'selected' : '' %>>Newest First</option>
                                                <option value="oldest" <%=typeof sort !=='undefined' && sort==='oldest'
                                                    ? 'selected' : '' %>>Oldest First</option>
                                                <option value="value_high" <%=typeof sort !=='undefined' &&
                                                    sort==='value_high' ? 'selected' : '' %>>Value: High to Low</option>
                                                <option value="value_low" <%=typeof sort !=='undefined' &&
                                                    sort==='value_low' ? 'selected' : '' %>>Value: Low to High</option>
                                            </select>
                                        </div>
                                    </form>
                                </div>
                                <div class="flex flex-col gap-6">
                                    <div
                                        class="rounded-xl border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] flex flex-col">
                                        <div class="hidden md:block overflow-x-auto">
                                            <table class="w-full text-left">
                                                <thead>
                                                    <tr class="border-b border-[#e0e0e0] dark:border-primary/20">
                                                        <th
                                                            class="p-4 text-sm font-semibold text-[#757575] dark:text-gray-400">
                                                            Offer Name
                                                        </th>
                                                        <th
                                                            class="p-4 text-sm font-semibold text-[#757575] dark:text-gray-400">
                                                            Type
                                                        </th>
                                                        <th
                                                            class="p-4 text-sm font-semibold text-[#757575] dark:text-gray-400">
                                                            Scope
                                                        </th>
                                                        <th
                                                            class="p-4 text-sm font-semibold text-[#757575] dark:text-gray-400">
                                                            Value
                                                        </th>
                                                        <th
                                                            class="p-4 text-sm font-semibold text-[#757575] dark:text-gray-400">
                                                            Start Date
                                                        </th>
                                                        <th
                                                            class="p-4 text-sm font-semibold text-[#757575] dark:text-gray-400">
                                                            End Date
                                                        </th>
                                                        <th
                                                            class="p-4 text-sm text-center font-semibold text-[#757575] dark:text-gray-400">
                                                            Status
                                                        </th>
                                                        <th
                                                            class="p-4 text-sm font-semibold text-[#757575] dark:text-gray-400 text-right">
                                                            Actions
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-[#e0e0e0] dark:divide-primary/20">
                                                    <% if (offers && offers.length> 0) { %>
                                                        <% offers.forEach(offer=> { %>
                                                            <tr>
                                                                <td
                                                                    class="p-4 whitespace-nowrap text-sm font-medium text-[#141414] dark:text-white">
                                                                    <%= offer.name %>
                                                                </td>
                                                                <td
                                                                    class="p-4 whitespace-nowrap text-sm text-[#141414] dark:text-white">
                                                                    <%= offer.type %>
                                                                </td>
                                                                <td
                                                                    class="p-4 whitespace-nowrap text-sm text-[#141414] dark:text-white">
                                                                    <%= offer.scope %>
                                                                </td>
                                                                <td
                                                                    class="p-4 whitespace-nowrap text-sm text-[#141414] dark:text-white">
                                                                    <%= offer.value %>
                                                                </td>
                                                                <td
                                                                    class="p-4 whitespace-nowrap text-sm text-[#141414] dark:text-white">
                                                                    <%= offer.start.toLocaleDateString() %>
                                                                </td>
                                                                <td
                                                                    class="p-4 whitespace-nowrap text-sm text-[#141414] dark:text-white">
                                                                    <%= offer.end.toLocaleDateString() %>
                                                                </td>
                                                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                                                    <% if (offer.isActive && new Date(offer.end)> new
                                                                        Date()) { %>
                                                                        <span
                                                                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">Active</span>
                                                                        <% } else if (!offer.isActive) { %>
                                                                            <span
                                                                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300">Inactive</span>
                                                                            <% } else { %>
                                                                                <span
                                                                                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-300">Expired</span>
                                                                                <% } %>
                                                                </td>
                                                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                                                    <a href="/admin/offers/edit/<%= offer._id %>"
                                                                        class="inline-block p-1.5 rounded-md hover:bg-primary/10 dark:hover:bg-primary/30">
                                                                        <span
                                                                            class="material-symbols-outlined text-lg">edit</span>
                                                                    </a>

                                                                    <button
                                                                        class="inline-block p-1.5 rounded-md block-btn <%= offer.isActive ? 'text-red-600 hover:bg-red-500/10 dark:hover:bg-red-500/20' : 'text-green-600 hover:bg-green-500/10 dark:hover:bg-green-500/20' %>"
                                                                        data-id="<%= offer._id %>"
                                                                        data-active="<%= offer.isActive %>"
                                                                        data-expiry="<%= offer.end %>"
                                                                        onclick="toggleOfferBlock('<%= offer.isActive %>', '<%= offer._id %>', this)">
                                                                        <span class="material-symbols-outlined text-lg">
                                                                            <%= offer.isActive ? 'block'
                                                                                : 'check_circle' %>
                                                                        </span>
                                                                    </button>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                                <% } else { %>
                                                                    <tr>
                                                                        <td colspan="6"
                                                                            class="px-6 py-12 text-center text-gray-500">
                                                                            No offers found.
                                                                        </td>
                                                                    </tr>
                                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>

                                        <!-- Mobile Card View -->
                                        <div class="grid grid-cols-1 gap-4 p-4 md:hidden">
                                            <% if (offers && offers.length> 0) { %>
                                                <% offers.forEach(offer=> { %>
                                                    <div
                                                        class="bg-white dark:bg-[#1f1f1f] p-4 rounded-xl border border-[#e0e0e0] dark:border-primary/20 shadow-sm flex flex-col gap-3">
                                                        <div
                                                            class="flex justify-between items-start border-b border-[#e0e0e0] dark:border-primary/20 pb-2">
                                                            <div>
                                                                <p class="text-xs text-[#757575] dark:text-gray-400">
                                                                    Offer Name</p>
                                                                <p class="font-bold text-[#141414] dark:text-white">
                                                                    <%= offer.name %>
                                                                </p>
                                                            </div>
                                                            <% if (offer.isActive && new Date(offer.end)> new Date()) {
                                                                %>
                                                                <span
                                                                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">Active</span>
                                                                <% } else if (!offer.isActive) { %>
                                                                    <span
                                                                        class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300">Inactive</span>
                                                                    <% } else { %>
                                                                        <span
                                                                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-300">Expired</span>
                                                                        <% } %>
                                                        </div>

                                                        <div class="flex justify-between items-center">
                                                            <div>
                                                                <p class="text-xs text-[#757575] dark:text-gray-400">
                                                                    Scope</p>
                                                                <p
                                                                    class="font-medium text-[#141414] dark:text-white capitalize">
                                                                    <%= offer.scope %>
                                                                </p>
                                                            </div>
                                                            <div class="text-right">
                                                                <p class="text-xs text-[#757575] dark:text-gray-400">
                                                                    Value</p>
                                                                <p class="font-bold text-green-600 dark:text-green-400">
                                                                    <%= offer.value %>
                                                                        <%= offer.type==='percentage' ? '%' : '₹' %>
                                                                </p>
                                                            </div>
                                                        </div>

                                                        <div
                                                            class="flex justify-between items-center bg-gray-50 dark:bg-white/5 p-3 rounded-lg text-sm">
                                                            <div>
                                                                <p class="text-xs text-[#757575] dark:text-gray-400">
                                                                    Start</p>
                                                                <p class="text-[#141414] dark:text-white">
                                                                    <%= offer.start.toLocaleDateString() %>
                                                                </p>
                                                            </div>
                                                            <span
                                                                class="material-symbols-outlined text-[#757575] text-sm">arrow_forward</span>
                                                            <div class="text-right">
                                                                <p class="text-xs text-[#757575] dark:text-gray-400">End
                                                                </p>
                                                                <p class="text-[#141414] dark:text-white">
                                                                    <%= offer.end.toLocaleDateString() %>
                                                                </p>
                                                            </div>
                                                        </div>

                                                        <div
                                                            class="flex items-center justify-end gap-3 mt-1 pt-2 border-t border-[#e0e0e0] dark:border-primary/20">
                                                            <a href="/admin/offers/edit/<%= offer._id %>"
                                                                class="flex items-center gap-1 text-sm font-medium text-primary dark:text-white hover:underline">
                                                                <span
                                                                    class="material-symbols-outlined text-lg">edit</span>
                                                                Edit
                                                            </a>
                                                            <button
                                                                onclick="toggleOfferBlock('<%= offer.isActive %>', '<%= offer._id %>', this)"
                                                                data-id="<%= offer._id %>"
                                                                data-active="<%= offer.isActive %>"
                                                                data-expiry="<%= offer.end %>"
                                                                class="flex items-center gap-1 text-sm font-medium hover:underline <%= offer.isActive ? 'text-red-600 dark:text-red-400' : 'text-green-600 dark:text-green-400' %>">
                                                                <span class="material-symbols-outlined text-lg">
                                                                    <%= offer.isActive ? 'block' : 'check_circle' %>
                                                                </span>
                                                                <%= offer.isActive ? 'Block' : 'Unblock' %>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <div
                                                                class="text-center text-gray-500 dark:text-gray-400 py-8">
                                                                No offers found.
                                                            </div>
                                                            <% } %>
                                        </div>
                                        <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
                                            <div
                                                class="p-4 flex justify-between items-center text-sm border-t border-[#e0e0e0] dark:border-primary/20">
                                                <p class="text-[#757575] dark:text-gray-400">
                                                    Showing <%= skip + 1 %> to <%= Math.min(skip + limit, totalOffers)
                                                            %> of <%= totalOffers %> offers
                                                </p>
                                                <div class="flex gap-2 items-center">
                                                    <a href="/admin/offers?page=<%= currentPage - 1 %>&search=<%= typeof search !== 'undefined' ? search : '' %>&isActive=<%= typeof isActive !== 'undefined' ? isActive : '' %>&scope=<%= typeof scope !== 'undefined' ? scope : '' %>&sort=<%= typeof sort !== 'undefined' ? sort : '' %>"
                                                        class="px-3 py-1 border border-[#e0e0e0] dark:border-primary/20 rounded-md hover:bg-gray-100 dark:hover:bg-primary/30 <%= currentPage === 1 ? 'pointer-events-none opacity-50' : '' %>">
                                                        Previous
                                                    </a>
                                                    <span class="px-2 text-gray-600 dark:text-gray-400">Page <%=
                                                            currentPage %> of <%= totalPages %></span>
                                                    <a href="/admin/offers?page=<%= currentPage + 1 %>&search=<%= typeof search !== 'undefined' ? search : '' %>&isActive=<%= typeof isActive !== 'undefined' ? isActive : '' %>&scope=<%= typeof scope !== 'undefined' ? scope : '' %>&sort=<%= typeof sort !== 'undefined' ? sort : '' %>"
                                                        class="px-3 py-1 border border-[#e0e0e0] dark:border-primary/20 rounded-md hover:bg-gray-100 dark:hover:bg-primary/30 <%= currentPage === totalPages ? 'pointer-events-none opacity-50' : '' %>">
                                                        Next
                                                    </a>
                                                </div>
                                            </div>
                                            <% } %>
                                    </div>
                                </div>
                            </div>
                        </main>
                </div>
            </div>
            <script>
                async function toggleOfferBlock(isActiveStr, id, btn) {
                    const isActive = isActiveStr === 'true';
                    const action = isActive ? "Block" : "Unblock";

                    const result = await Swal.fire({
                        title: "Are you sure?",
                        text: `Do you want to ${action.toLowerCase()} this offer?`,
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: isActive ? "#d33" : "#10b981",
                        cancelButtonColor: "#6b7280",
                        confirmButtonText: `Yes, ${action}!`
                    });

                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`/admin/offers/block/${id}?isActive=${isActive}`, {
                                method: 'PATCH',
                                headers: {
                                    'Content-Type': 'application/json'
                                }
                            });

                            const data = await response.json();

                            if (data.success) {
                                Swal.fire(
                                    `${action}ed!`,
                                    data.message,
                                    'success'
                                );

                                // Update UI
                                const isNowActive = data.isActive;

                                // Update dataset
                                btn.dataset.active = isNowActive;

                                // Update button onclick
                                btn.setAttribute('onclick', `toggleOfferBlock('${isNowActive}', '${id}', this)`);

                                // Update class for color
                                btn.className = `inline-block p-1.5 rounded-md block-btn ${isNowActive ? 'text-red-600 hover:bg-red-500/10 dark:hover:bg-red-500/20' : 'text-green-600 hover:bg-green-500/10 dark:hover:bg-green-500/20'}`;

                                // Update icon
                                const iconSpan = btn.querySelector('.material-symbols-outlined');
                                iconSpan.textContent = isNowActive ? 'block' : 'check_circle';

                                // Update Status badge
                                const row = btn.closest('tr');
                                const statusCell = row.querySelectorAll('td')[6];
                                if (statusCell) {
                                    let badgeHtml = '';
                                    const expiryDateStr = btn.dataset.expiry;
                                    const isExpired = expiryDateStr ? new Date(expiryDateStr) < new Date() : false;

                                    if (isNowActive) {
                                        if (isExpired) {
                                            badgeHtml = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-300">Expired</span>';
                                        } else {
                                            badgeHtml = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">Active</span>';
                                        }
                                    } else {
                                        badgeHtml = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300">Inactive</span>';
                                    }
                                    statusCell.innerHTML = badgeHtml;
                                }

                            } else {
                                Swal.fire('Error', data.message || 'Something went wrong', 'error');
                            }
                        } catch (error) {
                            console.error(error);
                            Swal.fire('Error', 'Failed to communicate with server', 'error');
                        }
                    }
                }
            </script>
    </body>

    </html>