<%- include('../../partials/admin-header.ejs') %>

    <body class="bg-background-light dark:bg-background-dark font-display text-[#141414] dark:text-white">
        <div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden">
            <div class="flex min-h-screen">
                <%- include('../../partials/sidebar.ejs') %>
                    <main class="flex-1 p-6 lg:p-10">
                        <div class="layout-content-container flex flex-col w-full max-w-7xl mx-auto">
                            <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-6">
                                <div class="flex flex-col gap-1">
                                    <p
                                        class="text-[#141414] dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]">
                                        Sales Report
                                    </p>
                                    <p class="text-[#757575] dark:text-gray-400 text-base font-normal leading-normal">
                                        Detailed insights into your sales performance.
                                    </p>
                                </div>
                                <div class="flex items-center gap-3">
                                    <details class="relative">
                                        <summary
                                            class="list-none flex items-center gap-2 cursor-pointer rounded-lg bg-white dark:bg-[#1f1f1f] border border-[#e0e0e0] dark:border-primary/20 text-[#141414] dark:text-white px-4 py-2.5 font-medium hover:bg-gray-50 dark:hover:bg-primary/30 transition-colors h-[46px]"
                                        >
                                            <span class="material-symbols-outlined text-xl">download</span>
                                            <span>Download Report</span>
                                            <span class="material-symbols-outlined text-lg ml-auto">expand_more</span>
                                        </summary>

                                        <div
                                            class="absolute right-0 top-full mt-2 w-48 bg-white dark:bg-[#1f1f1f] rounded-lg shadow-lg border border-[#e0e0e0] dark:border-primary/20 z-10 p-1"
                                        >
                                            <a
                                                class="flex items-center gap-2 px-3 py-2 hover:bg-gray-100 dark:hover:bg-primary/30 rounded text-sm"
                                                href="#"
                                                onclick="this.href='/admin/sales/download/pdf' + window.location.search"
                                            >
                                                <span class="material-symbols-outlined text-lg text-red-500">picture_as_pdf</span>
                                                PDF
                                            </a>

                                            <a
                                                class="flex items-center gap-2 px-3 py-2 hover:bg-gray-100 dark:hover:bg-primary/30 rounded text-sm"
                                                href="#"
                                                onclick="this.href='/admin/sales/download/excel' + window.location.search"
                                            >
                                                <span class="material-symbols-outlined text-lg text-green-600">table_view</span>
                                                Excel
                                            </a>
                                        </div>
                                    </details>

                                </div>
                            </div>
                            <div class="flex flex-col gap-6">
                                <form action="/admin/sales" method="GET"
                                    class="flex flex-col gap-4 rounded-xl border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] p-6 lg:flex-row lg:items-end">
                                    <div class="flex-1 lg:max-w-[180px]">
                                        <label class="text-[#141414] dark:text-white text-sm font-medium"
                                            for="period-select">Period</label>
                                        <div class="relative mt-2">
                                            <select name="period"
                                                class="w-full rounded-lg border border-[#e0e0e0] dark:border-primary/20 pl-4 pr-10 py-2.5 text-base font-normal text-[#141414] dark:text-white focus:outline-none focus:ring-2 focus:ring-primary/50 appearance-none bg-no-repeat bg-right"
                                                id="period-select" onchange="this.form.submit()">
                                                <option value="daily" <%=typeof period !=='undefined' && period==='daily' ? 'selected' : '' %>>Daily</option>
                                                <option value="weekly" <%=typeof period !=='undefined' && period==='weekly' ? 'selected' : '' %>>Weekly</option>
                                                <option value="monthly" <%=typeof period !=='undefined' && period==='monthly' ? 'selected' : '' %>>Monthly</option>
                                                <option value="yearly" <%=typeof period !=='undefined' && period==='yearly' ? 'selected' : '' %>>Yearly</option>
                                                <option value="custom" <%=typeof period !=='undefined' && period==='custom' ? 'selected' : '' %>>Custom Date</option>
                                            </select>
                                        </div>
                                    </div>

                                    <% if (typeof period !=='undefined' && period==='custom' ) { %>
                                        <div class="flex-1">
                                            <label class="text-[#141414] dark:text-white text-sm font-medium"
                                                for="start-date">Start Date</label>
                                            <div class="relative mt-2">
                                                <input type="date" name="startDate"
                                                    value="<%= typeof startDate !== 'undefined' ? startDate : '' %>"
                                                    class="w-full rounded-lg border border-[#e0e0e0] dark:border-primary/20 px-4 py-2.5 text-base font-normal text-[#141414] dark:text-white focus:outline-none focus:ring-2 focus:ring-primary/50"
                                                    id="start-date" />
                                            </div>
                                        </div>
                                        <div class="flex-1">
                                            <label class="text-[#141414] dark:text-white text-sm font-medium"
                                                for="end-date">End Date</label>
                                            <div class="relative mt-2">
                                                <input type="date" name="endDate"
                                                    value="<%= typeof endDate !== 'undefined' ? endDate : '' %>"
                                                    class="w-full rounded-lg border border-[#e0e0e0] dark:border-primary/20 px-4 py-2.5 text-base font-normal text-[#141414] dark:text-white focus:outline-none focus:ring-2 focus:ring-primary/50"
                                                    id="end-date" />
                                            </div>
                                        </div>
                                        <% } %>

                                            <button type="submit"
                                                class="flex items-center justify-center gap-2 rounded-lg bg-primary text-white px-5 py-2.5 font-medium hover:opacity-90 h-[46px]">
                                                <span>Apply</span>
                                            </button>
                                </form>

                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                                    <div
                                        class="flex flex-col rounded-xl border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] p-6">
                                        <p class="text-sm font-medium text-[#757575] dark:text-gray-400">Total Sales
                                            Count</p>
                                        <p class="text-3xl font-bold text-[#141414] dark:text-white mt-2">
                                            <%= typeof overallSalesCount !=='undefined' ? overallSalesCount : 0 %>
                                        </p>
                                        <p class="text-sm text-green-500 mt-1">Items sold</p>
                                    </div>
                                    <div
                                        class="flex flex-col rounded-xl border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] p-6">
                                        <p class="text-sm font-medium text-[#757575] dark:text-gray-400">Overall Order
                                            Amount</p>
                                        <p class="text-3xl font-bold text-[#141414] dark:text-white mt-2">
                                            <%= typeof overallOrderAmount !=='undefined' ? '₹' + overallOrderAmount.toFixed(2) : '₹0.00' %>
                                        </p>
                                        <p class="text-sm text-[#757575] mt-1">Gross sales</p>
                                    </div>
                                    <div
                                        class="flex flex-col rounded-xl border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] p-6">
                                        <p class="text-sm font-medium text-[#757575] dark:text-gray-400">Overall
                                            Discount</p>
                                        <p class="text-3xl font-bold text-red-500 mt-2">
                                            -<%= typeof overallDiscount !=='undefined' ? '₹' + overallDiscount.toFixed(2) : '₹0.00' %>
                                        </p>
                                        <p class="text-sm text-[#757575] mt-1">Total deductions</p>
                                    </div>
                                    <div
                                        class="flex flex-col rounded-xl border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] p-6">
                                        <p class="text-sm font-medium text-[#757575] dark:text-gray-400">Total Revenue
                                        </p>
                                        <p class="text-3xl font-bold text-green-700 dark:text-white mt-2">
                                            <%= typeof totalRevenue !=='undefined' ? '₹' + totalRevenue.toFixed(2) : '₹0.00' %>
                                        </p>
                                        <p class="text-sm text-green-500 mt-1">Net revenue</p>
                                    </div>
                                </div>
                                <div class="overflow-x-auto">
                                    <table
                                        class="w-full text-left text-sm text-[#141414] dark:text-white border border-gray-200 rounded-lg">
                                        <thead
                                            class="bg-gray-20 dark:bg-gray-400 text-[#757575] dark:text-gray-400 font-medium border-b border-[#e0e0e0] dark:border-primary/20">
                                            <tr>
                                                <th class="px-6 py-3 whitespace-nowrap">Order ID</th>
                                                <th class="px-6 py-3 whitespace-nowrap">Customer Name</th>
                                                <th class="px-6 py-3 whitespace-nowrap">Order Date</th>
                                                <th class="px-6 py-3 whitespace-nowrap">Payment</th>
                                                <th class="px-6 py-3 whitespace-nowrap">Status</th>
                                                <th class="px-6 py-3 whitespace-nowrap text-center">Coupen</th>
                                                <th class="px-6 py-3 whitespace-nowrap text-center">Discount</th>
                                                <th class="px-6 py-3 whitespace-nowrap text-right">Total Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-[#e0e0e0] dark:divide-primary/20">
                                            <% orders.forEach(order=> { %>
                                                <tr class="hover:bg-white dark:hover:bg-white transition-colors">
                                                    <td class="px-6 py-4 font-medium">ORD-<%= order.orderId.split('-')[2] %></td>
                                                    <td class="px-6 py-4">
                                                        <%= order.user.name %>
                                                    </td>
                                                    <td class="px-6 py-4">
                                                        <%= order.createdAt.toLocaleDateString() %>
                                                    </td>
                                                    <td class="px-6 py-4">
                                                        <%= order.paymentMethod %>
                                                    </td>
                                                    <td class="px-6 py-4">
                                                        <%
                                                        let statusClass = "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300";

                                                        switch (order.status) {
                                                            case "Cancelled":
                                                            case "Returned":
                                                                statusClass = "bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400";
                                                                break;

                                                            case "Processing":
                                                            case "Shipped":
                                                                statusClass = "bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400";
                                                                break;

                                                            case "Pending":
                                                                statusClass = "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400";
                                                                break;

                                                            case "Return Request":
                                                                statusClass = "bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-400";
                                                                break;
                                                            
                                                            case "Delivered":
                                                                statusClass = "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400";
                                                                break;
                                                        }
                                                        %>
                                                        <span
                                                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= statusClass %>">
                                                            <%= order.status %>
                                                        </span>
                                                    </td>
                                                    <td class="px-6 py-4 text-center"><%= order.coupenCode ? order.coupenCode : '-' %>
                                                    </td>
                                                    <td class="px-6 py-4 text-center text-green-700">-₹<%= order.coupenDiscount ? order.coupenDiscount : 0 %>
                                                    </td>
                                                    <td class="px-6 py-4 text-right">₹<%= order.totalAmount %>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </main>
            </div>
        </div>
    </body>

    </html>