<%- include('../partials/admin-header.ejs') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <body
        class="bg-background-light dark:bg-background-dark font-display text-[#141414] dark:text-white"
    >
    <%- include('../partials/flash.ejs') %>
        <div
            class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden"
        >
            <div class="flex min-h-screen">
                <!-- SideNavBar -->
                <%- include('../partials/sidebar.ejs') %>
                <!-- Main Content -->
                <main class="flex-1 p-6 lg:p-10">
                    <div class="layout-content-container flex flex-col w-full">
                        <!-- PageHeading -->
                        <div
                            class="flex flex-wrap justify-between gap-4 items-center mb-6"
                        >
                            <div class="flex flex-col gap-1">
                                <p
                                    class="text-[#141414] dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]"
                                >
                                    Dashboard
                                </p>
                                <p
                                    class="text-[#757575] dark:text-gray-400 text-base font-normal leading-normal"
                                >
                                    Welcome back, Admin! Here's your performance
                                    overview.
                                </p>
                            </div>
                            <div class="flex bg-gray-100 dark:bg-[#1f1f1f] rounded-lg p-1">
                                <a href="/admin/dashboard?type=monthly" 
                                class="px-4 py-2 rounded-md text-sm font-bold transition <%= type !== 'yearly' ? 'bg-black text-white' : 'text-gray-500' %>">
                                    Monthly
                                </a>
                                <a href="/admin/dashboard?type=yearly" 
                                class="px-4 py-2 rounded-md text-sm font-bold transition <%= type == 'yearly' ? 'bg-black text-white' : 'text-gray-500' %>">
                                    Yearly
                                </a>
                            </div>
                        </div>
                        <!-- Stats -->
                        <div
                            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"
                        >
                            <div
                                class="flex flex-col gap-2 rounded-xl p-6 bg-white dark:bg-[#1f1f1f] border border-[#e0e0e0] dark:border-primary/20"
                            >
                                <p
                                    class="text-[#141414] dark:text-white text-base font-medium leading-normal"
                                >
                                    Total Sales
                                </p>
                                <p
                                    class="text-[#141414] dark:text-white tracking-light text-3xl font-bold leading-tight"
                                >
                                    ₹<%= salesRecords.overallOrderAmount.toFixed(2) %>
                                </p>
                                <p
                                    class="text-[#078807] text-sm font-medium leading-normal"
                                >
                                    +5.8% vs last month
                                </p>
                            </div>
                            <div
                                class="flex flex-col gap-2 rounded-xl p-6 bg-white dark:bg-[#1f1f1f] border border-[#e0e0e0] dark:border-primary/20"
                            >
                                <p
                                    class="text-[#141414] dark:text-white text-base font-medium leading-normal"
                                >
                                    New Orders
                                </p>
                                <p
                                    class="text-[#141414] dark:text-white tracking-light text-3xl font-bold leading-tight"
                                >
                                    <%= salesRecords.orders.length %>
                                </p>
                                <p
                                    class="text-[#078807] text-sm font-medium leading-normal"
                                >
                                    +12% vs last month
                                </p>
                            </div>
                            <div
                                class="flex flex-col gap-2 rounded-xl p-6 bg-white dark:bg-[#1f1f1f] border border-[#e0e0e0] dark:border-primary/20"
                            >
                                <p
                                    class="text-[#141414] dark:text-white text-base font-medium leading-normal"
                                >
                                    Active Users
                                </p>
                                <p
                                    class="text-[#141414] dark:text-white tracking-light text-3xl font-bold leading-tight"
                                >
                                    <%= customers %>
                                </p>
                                <p
                                    class="text-[#e70808] text-sm font-medium leading-normal"
                                >
                                    -1.2% vs last month
                                </p>
                            </div>
                            <div
                                class="flex flex-col gap-2 rounded-xl p-6 bg-white dark:bg-[#1f1f1f] border border-[#e0e0e0] dark:border-primary/20"
                            >
                                <p
                                    class="text-[#141414] dark:text-white text-base font-medium leading-normal"
                                >
                                    Inventory Items
                                </p>
                                <p
                                    class="text-[#141414] dark:text-white tracking-light text-3xl font-bold leading-tight"
                                >
                                    <%= inventoryStock %>
                                </p>
                                <p
                                    class="text-[#757575] dark:text-gray-400 text-sm font-medium leading-normal"
                                >
                                    Total products in stock
                                </p>
                            </div>
                        </div>
                        <!-- Charts -->
                        <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 mt-6">
                            <div
                                class="lg:col-span-3 flex flex-col gap-2 rounded-xl border border-[#e0e0e0] dark:border-primary/20 p-6 bg-white dark:bg-[#1f1f1f]"
                            >
                                <p
                                    class="text-[#141414] dark:text-white text-lg font-medium leading-normal"
                                >
                                    Revenue Overview
                                </p>
                                <div class="flex gap-1 items-baseline">
                                    <p
                                        class="text-[#141414] dark:text-white tracking-light text-[32px] font-bold leading-tight truncate"
                                    >
                                        ₹<%= salesRecords.totalRevenue.toFixed(2) %>
                                    </p>
                                    <p
                                        class="text-[#078807] text-base font-medium leading-normal ml-2"
                                    >
                                        +12.5%
                                    </p>
                                </div>
                                <p
                                    class="text-[#757575] dark:text-gray-400 text-sm font-normal leading-normal"
                                >
                                    Last 30 Days
                                </p>
                                <div
                                    class="flex min-h-[240px] flex-1 flex-col gap-8 py-4 mt-4"
                                >
                                    <canvas id="salesChart"></canvas>
                                </div>
                            </div>
                            <div
                                class="lg:col-span-2 flex flex-col gap-2 rounded-xl border border-[#e0e0e0] dark:border-primary/20 p-6 bg-white dark:bg-[#1f1f1f]"
                            >
                                <p
                                    class="text-[#141414] dark:text-white text-lg font-medium leading-normal"
                                >
                                    Top Selling Categories
                                </p>
                                <div class="flex gap-1 items-baseline">
                                    <p
                                        class="text-[#141414] dark:text-white tracking-light text-[32px] font-bold leading-tight truncate"
                                    >
                                        <%= topCategories[0].totalSales %> Units
                                    </p>
                                </div>
                                <p
                                    class="text-[#757575] dark:text-gray-400 text-sm font-normal leading-normal"
                                >
                                    <%= topCategories[0]._id %>
                                </p>
                                <div
                                    class="grid h-[400px] min-h-[250px] grid-flow-col gap-6 grid-rows-[1fr_auto] items-end justify-items-center px-3 mt-4"
                                >
                                    <canvas id="categoryChart"></canvas>
                                </div>
                            </div>
                        </div>
                        <div
                            class="md:col-span-2 h-[550px] flex flex-col gap-2 mt-6 rounded-xl border border-[#e0e0e0] dark:border-primary/20 p-6 bg-white dark:bg-[#1f1f1f]"
                        >
                            <p
                                class="text-[#141414] dark:text-white text-lg font-medium leading-normal"
                            >
                                Top Selling Products
                            </p>
                            <div
                                class="flex min-h-[240px] flex-1 flex-col gap-8 mt-4 p-4"
                            >
                                <canvas id="topProducts"></canvas>
                            </div>
                        </div>
                        <!-- Activity & Alerts -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
                            <!-- Recent Activity -->
                            <div
                                class="flex flex-col rounded-xl border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f]"
                            >
                                <div class="p-6">
                                    <h2
                                        class="text-[#141414] dark:text-white text-lg font-bold leading-tight tracking-[-0.015em]"
                                    >
                                        Recent Activity
                                    </h2>
                                    <p
                                        class="text-[#757575] dark:text-gray-400 text-sm mt-1"
                                    >
                                        Latest orders and sign-ups.
                                    </p>
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left">
                                        <thead
                                            class="text-sm text-[#757575] dark:text-gray-400"
                                        >
                                            <tr
                                                class="border-b border-[#e0e0e0] dark:border-primary/20"
                                            >
                                                <th
                                                    class="px-6 py-3 font-medium"
                                                >
                                                    Order ID
                                                </th>
                                                <th
                                                    class="px-6 py-3 font-medium"
                                                >
                                                    Customer
                                                </th>
                                                <th
                                                    class="px-6 py-3 font-medium"
                                                >
                                                    Status
                                                </th>
                                                <th
                                                    class="px-6 py-3 font-medium text-right"
                                                >
                                                    Total
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% recentOrders.forEach(order => { %>
                                            <tr
                                                class="border-b border-[#e0e0e0] dark:border-primary/20"
                                            >
                                                <td
                                                    class="px-6 py-4 font-medium text-[#141414] dark:text-white"
                                                >
                                                    #<%= order.orderId.split('-')[2] %>
                                                </td>
                                                <td
                                                    class="px-6 py-4 text-[#757575] dark:text-gray-400"
                                                >
                                                    <%= order.user.name %>
                                                </td>
                                                <td class="px-6 py-4">
                                                    <% if (order.status == 'Cancelled' || order.status == 'Return Request' || order.status == 'Returned') { %>
                                                     <span
                                                        class="bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300 text-xs font-medium px-2.5 py-1 rounded-full"
                                                        ><%= order.status %></span
                                                    >
                                                    <% } else { %>
                                                    <span
                                                        class="bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300 text-xs font-medium px-2.5 py-1 rounded-full"
                                                        ><%= order.status %></span
                                                    >
                                                    <% } %>
                                                </td>
                                                <td
                                                    class="px-6 py-4 text-right font-medium text-[#141414] dark:text-white"
                                                >
                                                    ₹<%= order.totalAmount.toFixed(2) %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <!-- Low Stock -->
                            <div
                                class="flex flex-col rounded-xl border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f]"
                            >
                                <div class="p-6">
                                    <h2
                                        class="text-[#141414] dark:text-white text-lg font-bold leading-tight tracking-[-0.015em]"
                                    >
                                        Low Stock Alerts
                                    </h2>
                                    <p
                                        class="text-[#757575] dark:text-gray-400 text-sm mt-1"
                                    >
                                        Products that need restocking soon.
                                    </p>
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left">
                                        <thead
                                            class="text-sm text-[#757575] dark:text-gray-400"
                                        >
                                            <tr
                                                class="border-b border-[#e0e0e0] dark:border-primary/20"
                                            >
                                                <th
                                                    class="px-6 py-3 font-medium"
                                                >
                                                    Product Name
                                                </th>
                                                <th
                                                    class="px-6 py-3 font-medium"
                                                >
                                                    Size
                                                </th>
                                                <th
                                                    class="px-6 py-3 font-medium text-right"
                                                >
                                                    Remaining
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% stockAlerts.forEach(alert => { %>
                                            <tr
                                                class="border-b border-[#e0e0e0] dark:border-primary/20"
                                            >
                                                <td
                                                    class="px-6 py-4 font-medium text-[#141414] dark:text-white"
                                                >
                                                    <%= alert.name %>
                                                </td>
                                                <td
                                                    class="px-6 py-4 text-[#757575] dark:text-gray-400"
                                                >
                                                    <%= alert.variants[0].size %>
                                                </td>
                                                <td
                                                    class="px-6 py-4 text-right font-medium text-red-600 dark:text-red-400"
                                                >
                                                    <%= Math.min(...alert.variants.map(v => v.stock)) %> Units
                                                </td>
                                            </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
        <script>
            function renderSalesChart() {
                const data = JSON.parse('<%- JSON.stringify(formattedData) %>');
                const labels = data.map(item => item.label);
                const sales = data.map(item => item.sales);

                const ctx = document.getElementById('salesChart').getContext('2d');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Sales',
                            data: sales,
                            backgroundColor: 'rgba(0, 0, 0, 0.5)',
                            borderColor: 'rgba(0, 0, 0, 1)',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            }

            function renderTopCatgs() {
                const data = JSON.parse('<%- JSON.stringify(topCategories) %>');
                const labels = data.map(item => item._id);
                const sales = data.map(item => item.totalSales);

                const ctx = document.getElementById('categoryChart').getContext('2d');
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Sales',
                            data: sales,
                            backgroundColor: [
                                '#003f5c',
                                '#ffa600',
                                '#58508d',
                                '#ff6361',
                                '#bc5090',
                            ],
                            borderColor: 'rgba(0, 0, 0, 1)',
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            }

            function renderTopProds() {
                const data = JSON.parse('<%- JSON.stringify(topProducts) %>');
                const labels = data.map(item => item.name);
                const sales = data.map(item => item.totalSold);

                const ctx = document.getElementById('topProducts').getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'sales',
                            data: sales,
                            backgroundColor: [
                                'rgb(0, 0, 0)',
                                'rgb(100, 100, 100)',
                                'rgb(150, 150, 150)',
                                '#003f5c',
                            ],
                            borderColor: 'rgba(0, 0, 0, 1)',
                            borderWidth: 0
                        }]
                    },
                    options: {
                        indexAxis: 'y', // This makes the bar horizontal
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: {
                                beginAtZero: true,
                                grid: { display: false }
                            },
                            y: {
                                grid: { display: false }
                            }
                        },
                        plugins: {
                            legend: { display: false } // Usually better for top products
                        }
                    }
                });
            }

            // Call the function to render the chart when the page loads
            document.addEventListener('DOMContentLoaded', () => {
                renderSalesChart();
                renderTopCatgs();
                renderTopProds();
            });
        </script>
    </body>
</html>
