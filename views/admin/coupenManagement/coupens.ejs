<%- include('../../partials/admin-header.ejs') %>

    <body class="bg-background-light dark:bg-background-dark font-display text-[#141414] dark:text-white">
        <div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden">
            <div class="flex min-h-screen">
                <%- include('../../partials/sidebar.ejs') %>
                    <main class="flex-1 p-6 lg:p-10">
                        <div class="layout-content-container flex flex-col w-full max-w-7xl mx-auto">
                            <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-center sm:justify-between">
                                <div class="flex flex-col gap-1">
                                    <p
                                        class="text-[#141414] dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]">
                                        Coupon Management
                                    </p>
                                    <p class="text-[#757575] dark:text-gray-400 text-base font-normal leading-normal">
                                        Manage, edit, and create new coupons for
                                        your store.
                                    </p>
                                </div>
                                <a href="/admin/coupens/create"
                                    class="flex items-center justify-center gap-2 rounded-lg bg-primary text-white px-5 py-2.5 font-medium hover:opacity-90 w-full sm:w-auto h-[46px]">
                                    <span class="material-symbols-outlined">add</span>
                                    <span>Create New Coupon</span>
                                </a>
                            </div>

                            <div class="flex flex-col gap-4 mb-6">
                                <form action="/admin/coupens" method="GET"
                                    class="flex flex-col sm:flex-row gap-4 w-full">
                                    <div class="relative flex-1">
                                        <span
                                            class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-gray-500 text-lg">search</span>
                                        <input type="text" name="search"
                                            value="<%= typeof search !== 'undefined' ? search : '' %>"
                                            placeholder="Search by coupon code..."
                                            class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] text-sm focus:outline-none focus:border-primary transition-colors">
                                    </div>

                                    <div class="flex flex-wrap gap-4">
                                        <select name="isActive" onchange="this.form.submit()"
                                            class="px-4 py-2.5 rounded-lg border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] text-sm focus:outline-none focus:border-primary cursor-pointer">
                                            <option value="">All Status</option>
                                            <option value="active" <%=typeof isActive !=='undefined' &&
                                                isActive==='active' ? 'selected' : '' %>>Active</option>
                                            <option value="inactive" <%=typeof isActive !=='undefined' &&
                                                isActive==='inactive' ? 'selected' : '' %>>Inactive</option>
                                        </select>

                                        <select name="discountType" onchange="this.form.submit()"
                                            class="px-4 py-2.5 rounded-lg border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] text-sm focus:outline-none focus:border-primary cursor-pointer">
                                            <option value="">All Types</option>
                                            <option value="percentage" <%=typeof discountType !=='undefined' &&
                                                discountType==='percentage' ? 'selected' : '' %>>Percentage</option>
                                            <option value="fixed" <%=typeof discountType !=='undefined' &&
                                                discountType==='fixed' ? 'selected' : '' %>>Fixed Amount</option>
                                        </select>

                                        <select name="sort" onchange="this.form.submit()"
                                            class="px-4 py-2.5 rounded-lg border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] text-sm focus:outline-none focus:border-primary cursor-pointer">
                                            <option value="newest" <%=typeof sort !=='undefined' && sort==='newest'
                                                ? 'selected' : '' %>>Newest First</option>
                                            <option value="oldest" <%=typeof sort !=='undefined' && sort==='oldest'
                                                ? 'selected' : '' %>>Oldest First</option>
                                            <option value="expiry_near" <%=typeof sort !=='undefined' &&
                                                sort==='expiry_near' ? 'selected' : '' %>>Expiry: Near to Far</option>
                                            <option value="expiry_far" <%=typeof sort !=='undefined' &&
                                                sort==='expiry_far' ? 'selected' : '' %>>Expiry: Far to Near</option>
                                            <option value="value_high" <%=typeof sort !=='undefined' &&
                                                sort==='value_high' ? 'selected' : '' %>>Value: High to Low</option>
                                            <option value="value_low" <%=typeof sort !=='undefined' &&
                                                sort==='value_low' ? 'selected' : '' %>>Value: Low to High</option>
                                        </select>
                                    </div>
                                </form>
                            </div>
                            <div
                                class="rounded-xl border border-[#e0e0e0] dark:border-primary/20 bg-white dark:bg-[#1f1f1f] flex flex-col">
                                <div class="hidden md:block overflow-x-auto">
                                    <table class="w-full text-sm text-left">
                                        <thead class="border-b border-[#e0e0e0] dark:border-primary/20">
                                            <tr>
                                                <th class="px-6 py-4 font-medium text-[#757575] dark:text-gray-400 uppercase tracking-wider"
                                                    scope="col">
                                                    Coupon Code
                                                </th>
                                                <th class="px-6 py-4 font-medium text-[#757575] dark:text-gray-400 uppercase tracking-wider"
                                                    scope="col">
                                                    Discount Type
                                                </th>
                                                <th class="px-6 py-4 font-medium text-[#757575] dark:text-gray-400 uppercase tracking-wider"
                                                    scope="col">
                                                    Value
                                                </th>
                                                <th class="px-6 py-4 font-medium text-[#757575] dark:text-gray-400 uppercase tracking-wider"
                                                    scope="col">
                                                    Used Count
                                                </th>
                                                <th class="px-6 py-4 font-medium text-[#757575] dark:text-gray-400 uppercase tracking-wider"
                                                    scope="col">
                                                    Usage Limit
                                                </th>
                                                <th class="px-6 py-4 font-medium text-[#757575] dark:text-gray-400 uppercase tracking-wider"
                                                    scope="col">
                                                    Expiration Date
                                                </th>
                                                <th class="px-6 py-4 font-medium text-[#757575] dark:text-gray-400 uppercase tracking-wider"
                                                    scope="col">
                                                    Status
                                                </th>
                                                <th class="px-6 py-4 font-medium text-right text-[#757575] dark:text-gray-400 uppercase tracking-wider"
                                                    scope="col">
                                                    Actions
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-[#e0e0e0] dark:divide-primary/20">
                                            <% if (typeof coupens !=='undefined' && coupens.length> 0) { %>
                                                <% coupens.forEach(coupen=> { %>
                                                    <tr class="hover:bg-primary/5 dark:hover:bg-primary/20">
                                                        <td class="px-6 py-4 font-medium whitespace-nowrap">
                                                            <%= coupen.code %>
                                                        </td>
                                                        <td class="px-6 py-4 whitespace-nowrap">
                                                            <%= coupen.discountType==='percentage' ? 'Percentage'
                                                                : 'Fixed Amount' %>
                                                        </td>
                                                        <td class="px-6 py-4 whitespace-nowrap">
                                                            <%= coupen.discountType==='percentage' ?
                                                                coupen.discountValue + '%' : '₹' + coupen.discountValue
                                                                %>
                                                        </td>
                                                        <td class="px-6 py-4 whitespace-nowrap text-center">
                                                            <%= coupen.usedCount %>
                                                        </td>
                                                        <td class="px-6 py-4 whitespace-nowrap">
                                                            <%= coupen.usageLimit ? coupen.usageLimit : 'Unlimited' %>
                                                        </td>
                                                        <td class="px-6 py-4 whitespace-nowrap">
                                                            <%= new Date(coupen.expirationDate).toLocaleDateString() %>
                                                        </td>
                                                        <td class="px-6 py-4 whitespace-nowrap">
                                                            <% if (coupen.isActive && new Date(coupen.expirationDate)>
                                                                new Date()) { %>
                                                                <span
                                                                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">Active</span>
                                                                <% } else if (!coupen.isActive) { %>
                                                                    <span
                                                                        class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300">Inactive</span>
                                                                    <% } else { %>
                                                                        <span
                                                                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-300">Expired</span>
                                                                        <% } %>
                                                        </td>
                                                        <td class="px-6 py-4 whitespace-nowrap text-right">
                                                            <a href="/admin/coupens/edit/<%= coupen._id %>"
                                                                class="inline-block p-1.5 rounded-md hover:bg-primary/10 dark:hover:bg-primary/30">
                                                                <span
                                                                    class="material-symbols-outlined text-lg">edit</span>
                                                            </a>
                                                            <button
                                                                class="inline-block p-1.5 rounded-md block-btn <%= coupen.isActive ? 'text-red-600 hover:bg-red-500/10 dark:hover:bg-red-500/20' : 'text-green-600 hover:bg-green-500/10 dark:hover:bg-green-500/20' %>"
                                                                data-expiry="<%= coupen.expirationDate %>"
                                                                onclick="toggleCouponBlock('<%= coupen.isActive %>', '<%= coupen._id %>', this)">
                                                                <span class="material-symbols-outlined text-lg">
                                                                    <%= coupen.isActive ? 'block' : 'check_circle' %>
                                                                </span>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                                        <% } else { %>
                                                            <tr>
                                                                <td colspan="7"
                                                                    class="px-6 py-4 text-center text-gray-500 dark:text-gray-400">
                                                                    No coupons found.
                                                                </td>
                                                            </tr>
                                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Mobile Card View -->
                                <div class="grid grid-cols-1 gap-4 p-4 md:hidden">
                                    <% if (typeof coupens !=='undefined' && coupens.length> 0) { %>
                                        <% coupens.forEach(coupen=> { %>
                                            <div
                                                class="bg-white dark:bg-[#1f1f1f] p-4 rounded-xl border border-[#e0e0e0] dark:border-primary/20 shadow-sm flex flex-col gap-3">
                                                <div
                                                    class="flex justify-between items-start border-b border-[#e0e0e0] dark:border-primary/20 pb-2">
                                                    <div>
                                                        <p class="text-xs text-[#757575] dark:text-gray-400">Coupon Code
                                                        </p>
                                                        <p class="font-bold text-[#141414] dark:text-white text-lg">
                                                            <%= coupen.code %>
                                                        </p>
                                                    </div>
                                                    <% if (coupen.isActive && new Date(coupen.expirationDate)> new
                                                        Date()) { %>
                                                        <span
                                                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">Active</span>
                                                        <% } else if (!coupen.isActive) { %>
                                                            <span
                                                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300">Inactive</span>
                                                            <% } else { %>
                                                                <span
                                                                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-300">Expired</span>
                                                                <% } %>
                                                </div>

                                                <div class="flex justify-between items-center">
                                                    <div>
                                                        <p class="text-xs text-[#757575] dark:text-gray-400">Type</p>
                                                        <p class="font-medium text-[#141414] dark:text-white text-sm">
                                                            <%= coupen.discountType==='percentage' ? 'Percentage'
                                                                : 'Fixed Amount' %>
                                                        </p>
                                                    </div>
                                                    <div class="text-right">
                                                        <p class="text-xs text-[#757575] dark:text-gray-400">Value</p>
                                                        <p class="font-medium text-green-600 dark:text-green-400">
                                                            <%= coupen.discountType==='percentage' ?
                                                                coupen.discountValue + '%' : '₹' + coupen.discountValue
                                                                %>
                                                        </p>
                                                    </div>
                                                </div>

                                                <div class="flex justify-between items-center">
                                                    <div>
                                                        <p class="text-xs text-[#757575] dark:text-gray-400">Used /
                                                            Limit</p>
                                                        <p class="font-medium text-[#141414] dark:text-white">
                                                            <%= coupen.usedCount %> / <%= coupen.usageLimit ?
                                                                    coupen.usageLimit : '∞' %>
                                                        </p>
                                                    </div>
                                                    <div class="text-right">
                                                        <p class="text-xs text-[#757575] dark:text-gray-400">Expires</p>
                                                        <p class="font-medium text-[#141414] dark:text-white">
                                                            <%= new Date(coupen.expirationDate).toLocaleDateString() %>
                                                        </p>
                                                    </div>
                                                </div>

                                                <div
                                                    class="flex items-center justify-end gap-3 mt-2 pt-2 border-t border-[#e0e0e0] dark:border-primary/20">
                                                    <a href="/admin/coupens/edit/<%= coupen._id %>"
                                                        class="flex items-center gap-1 text-sm font-medium text-primary dark:text-white hover:underline">
                                                        <span class="material-symbols-outlined text-lg">edit</span> Edit
                                                    </a>
                                                    <button
                                                        onclick="toggleCouponBlock('<%= coupen.isActive %>', '<%= coupen._id %>', this)"
                                                        data-expiry="<%= coupen.expirationDate %>"
                                                        class="flex items-center gap-1 text-sm font-medium hover:underline <%= coupen.isActive ? 'text-red-600 dark:text-red-400' : 'text-green-600 dark:text-green-400' %>">
                                                        <span class="material-symbols-outlined text-lg">
                                                            <%= coupen.isActive ? 'block' : 'check_circle' %>
                                                        </span>
                                                        <%= coupen.isActive ? 'Block' : 'Unblock' %>
                                                    </button>
                                                </div>
                                            </div>
                                            <% }) %>
                                                <% } else { %>
                                                    <div class="text-center text-gray-500 dark:text-gray-400 py-8">
                                                        No coupons found.
                                                    </div>
                                                    <% } %>
                                </div>
                                <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
                                    <div
                                        class="p-4 flex justify-between items-center text-sm border-t border-[#e0e0e0] dark:border-primary/20">
                                        <p class="text-[#757575] dark:text-gray-400">
                                            Showing <%= (currentPage - 1) * limit + 1 %> to <%= Math.min(currentPage *
                                                    limit, totalCoupens) %> of <%= totalCoupens %> coupons
                                        </p>
                                        <div class="flex gap-2 items-center">
                                            <a href="/admin/coupens?page=<%= currentPage - 1 %>&search=<%= typeof search !== 'undefined' ? search : '' %>&isActive=<%= typeof isActive !== 'undefined' ? isActive : '' %>&discountType=<%= typeof discountType !== 'undefined' ? discountType : '' %>&sort=<%= typeof sort !== 'undefined' ? sort : '' %>"
                                                class="px-3 py-1 border border-[#e0e0e0] dark:border-primary/20 rounded-md hover:bg-gray-100 dark:hover:bg-primary/30 <%= currentPage === 1 ? 'pointer-events-none opacity-50' : '' %>">
                                                Previous
                                            </a>
                                            <span class="px-2 text-gray-600 dark:text-gray-400">Page <%= currentPage %>
                                                    of <%= totalPages %></span>
                                            <a href="/admin/coupens?page=<%= currentPage + 1 %>&search=<%= typeof search !== 'undefined' ? search : '' %>&isActive=<%= typeof isActive !== 'undefined' ? isActive : '' %>&discountType=<%= typeof discountType !== 'undefined' ? discountType : '' %>&sort=<%= typeof sort !== 'undefined' ? sort : '' %>"
                                                class="px-3 py-1 border border-[#e0e0e0] dark:border-primary/20 rounded-md hover:bg-gray-100 dark:hover:bg-primary/30 <%= currentPage === totalPages ? 'pointer-events-none opacity-50' : '' %>">
                                                Next
                                            </a>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                        </div>
                    </main>
            </div>
        </div>
        <script>
            async function toggleCouponBlock(isActiveStr, id, btn) {
                const isActive = isActiveStr === 'true';
                const action = isActive ? "Block" : "Unblock";

                const result = await Swal.fire({
                    title: "Are you sure?",
                    text: `Do you want to ${action.toLowerCase()} this coupon?`,
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: isActive ? "#d33" : "#10b981",
                    cancelButtonColor: "#6b7280",
                    confirmButtonText: `Yes, ${action}!`
                });

                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/coupens/block/${id}`, {
                            method: 'PATCH',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        });

                        const data = await response.json();

                        if (data.success) {
                            Swal.fire(
                                `${action}ed!`,
                                data.message,
                                'success'
                            );

                            // Update UI
                            const isNowActive = data.isActive;

                            // Update dataset
                            // Update button onclick
                            btn.setAttribute('onclick', `toggleCouponBlock('${isNowActive}', '${id}', this)`);

                            // Update class for color
                            btn.className = `inline-block p-1.5 rounded-md block-btn ${isNowActive ? 'text-red-600 hover:bg-red-500/10 dark:hover:bg-red-500/20' : 'text-green-600 hover:bg-green-500/10 dark:hover:bg-green-500/20'}`;

                            // Update icon
                            const iconSpan = btn.querySelector('.material-symbols-outlined');
                            iconSpan.textContent = isNowActive ? 'block' : 'check_circle';

                            // Update Status badge
                            const row = btn.closest('tr');
                            const statusCell = row.querySelectorAll('td')[6];
                            if (statusCell) {
                                let badgeHtml = '';
                                const expiryDateStr = btn.dataset.expiry;
                                const isExpired = expiryDateStr ? new Date(expiryDateStr) < new Date() : false;

                                if (isNowActive) {
                                    if (isExpired) {
                                        badgeHtml = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-300">Expired</span>';
                                    } else {
                                        badgeHtml = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">Active</span>';
                                    }
                                } else {
                                    badgeHtml = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300">Inactive</span>';
                                }
                                statusCell.innerHTML = badgeHtml;
                            }

                        } else {
                            Swal.fire('Error', data.message || 'Something went wrong', 'error');
                        }
                    } catch (error) {
                        console.error(error);
                        Swal.fire('Error', 'Failed to communicate with server', 'error');
                    }
                }
            }
        </script>
    </body>

    </html>