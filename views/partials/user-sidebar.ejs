<aside
    class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 md:border-t-0 md:bg-transparent md:static md:w-64 md:sticky md:top-28 flex flex-row md:flex-col items-center md:items-stretch justify-around md:justify-start px-2 py-2 md:p-0 md:pr-8 md:max-h-[80vh] md:border-r gap-0 md:gap-8 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] md:shadow-none">
    <div class="hidden md:flex items-center gap-4">
        <img src="<%= user.avatar ? user.avatar : 'https://picsum.photos/100/100' %>" alt="profile pic"
            class="rounded-full size-10">
        <div class="flex flex-col">
            <h1 class="text-[#1A1A1A] text-lg font-bold leading-tight">
                <%= user.name %>
            </h1>
            <p class="text-gray-500 text-sm font-medium">
                <%= user.email %>
            </p>
        </div>
    </div>

    <nav class="flex flex-1 justify-around md:justify-start md:flex-col gap-1 md:gap-2 w-full md:w-auto">
        <a href="/profile/details"
            class="flex flex-col md:flex-row items-center justify-center md:justify-start gap-1 md:gap-3 p-2 md:px-4 md:py-3 rounded-lg md:rounded-xl text-gray-500 hover:bg-gray-50 hover:text-black transition-all">
            <i class="ph-bold ph-user text-xl md:text-lg"></i>
            <span class="text-[10px] md:text-sm font-bold">Details</span>
        </a>
        <a href="/profile/orders"
            class="flex flex-col md:flex-row items-center justify-center md:justify-start gap-1 md:gap-3 p-2 md:px-4 md:py-3 rounded-lg md:rounded-xl text-gray-500 hover:bg-gray-50 hover:text-black transition-all">
            <i class="ph-bold ph-receipt text-xl md:text-lg"></i>
            <span class="text-[10px] md:text-sm font-bold">Orders</span>
        </a>
        <a href="/profile/addresses"
            class="flex flex-col md:flex-row items-center justify-center md:justify-start gap-1 md:gap-3 p-2 md:px-4 md:py-3 rounded-lg md:rounded-xl text-gray-500 hover:bg-gray-50 hover:text-black transition-all">
            <i class="ph-bold ph-map-pin text-xl md:text-lg"></i>
            <span class="text-[10px] md:text-sm font-bold">Address</span>
        </a>
        <a href="/profile/wallet"
            class="flex flex-col md:flex-row items-center justify-center md:justify-start gap-1 md:gap-3 p-2 md:px-4 md:py-3 rounded-lg md:rounded-xl text-gray-500 hover:bg-gray-50 hover:text-black transition-all">
            <i class="ph-bold ph-wallet text-xl md:text-lg"></i>
            <span class="text-[10px] md:text-sm font-bold">Wallet</span>
        </a>

        <!-- Mobile Logout (Integrated in Nav) -->
        <form action="/logout" method="POST" class="md:hidden flex">
            <button type="submit"
                class="flex flex-col items-center justify-center gap-1 p-2 rounded-lg text-red-500 hover:bg-red-50 transition-all">
                <i class="ph-bold ph-sign-out text-xl"></i>
                <span class="text-[10px] font-bold">Logout</span>
            </button>
        </form>
    </nav>

    <!-- Desktop Logout -->
    <div class="hidden md:block mt-auto pt-8 border-t border-gray-100">
        <form action="/logout" method="POST">
            <button type="submit"
                class="flex items-center w-full gap-3 px-4 py-3 rounded-xl text-red-500 hover:bg-red-50 transition-all">
                <i class="ph-bold ph-sign-out text-lg"></i>
                <span class="text-sm font-bold">Logout</span>
            </button>
        </form>
    </div>
</aside>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const sidebarLinks = document.querySelectorAll('aside nav a');

        // 1. Get current path and remove trailing slash (e.g., "/profile/" becomes "/profile")
        const currentPath = window.location.pathname.replace(/\/$/, "");

        console.log("📍 Current Browser Path:", currentPath);

        sidebarLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (!href || href === '#') return;

            // 2. Clean the link href too
            const cleanHref = href.replace(/\/$/, "");

            console.log("🔗 Checking Link:", cleanHref);

            // 3. Robust Comparison
            // Condition A: Exact Match (Normal pages)
            // Condition B: Sub-path Match (Order details page)
            const isActive =
                currentPath === cleanHref ||
                (currentPath.startsWith(cleanHref) && cleanHref !== '/profile' && cleanHref.length > 1);

            if (isActive) {
                console.log("✅ MATCH FOUND!");

                // Force remove old classes
                link.classList.remove('text-gray-500', 'hover:bg-gray-50', 'hover:text-black');

                // Force add active classes
                link.classList.add('bg-gray-100', 'text-black', 'shadow-lg', 'shadow-gray/5');
            }
        });
    });
</script>